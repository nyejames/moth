@core/math PI, sin, cos, sqrt
@data/constants base_count, scale_factor

scaled_count || -> I32:
    return base_count * scale_factor
;

wave |phase F64| -> F64:
    return sin(phase) + cos(phase * 2.0)
;

hypotenuse |a F64, b F64| -> F64:
    return sqrt((a * a) + (b * b))
;

pi_value || -> F64:
    return PI
;
