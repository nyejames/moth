@types/models User, UserProfile
@types/enums Status, Priority
@core/constants max_items_per_page
@utils/formatting format_label
@widgets/card Card
@widgets/badge render_badge

render_home |user User| -> String:
    if user.status is Status::Active:
        return [: Active user [user.username] with [max_items_per_page] items]
    ;
    return [: Inactive user [user.username]]
;
