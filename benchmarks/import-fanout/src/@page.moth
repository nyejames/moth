@core/constants app_name, app_version
@core/constants build_timestamp as built_at
@types/models User, UserProfile
@types/enums Status, Priority
@utils/formatting format_label, format_timestamp
@utils/math clamp
@widgets/header render_header
@widgets/footer render_footer
@widgets/card render_card, Card
@pages/home render_home
@pages/about render_about

page_title #= [: [app_name] v[app_version]]

user ~= User("admin", "admin@example.com", Status::Active)
profile ~= UserProfile("Admin User", "Administrator", Priority::High)

card_a = Card(format_label("Home"), render_home(user))
card_b = Card(format_label("About"), render_about(profile))

[:
    [render_header(page_title)]
    <main>
        [render_card(card_a)]
        [render_card(card_b)]
    </main>
    [render_footer(built_at)]
]
