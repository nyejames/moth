clamp |value I32, minimum I32, maximum I32| -> I32:
    if value < minimum:
        return minimum
    ;
    if value > maximum:
        return maximum
    ;
    return value
;

scale_value |value I32, factor F64| -> F64:
    converted F64 = cast value
    return converted * factor
;

squared |value I32| -> I32:
    return value * value
;
