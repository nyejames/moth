@types/enums Status, Priority, PermissionLevel

User = |
    username String,
    email String,
    status Status,
|

UserProfile = |
    display_name String,
    role String,
    priority Priority,
|

Session = |
    token String,
    expires_at I32,
    permission PermissionLevel,
|

Settings = |
    theme String,
    notifications Bool,
    language String,
|

Product = |
    name String,
    price F64,
    category String,
|

ProductCategory = |
    label String,
    sort_order I32,
|

InventoryItem = |
    sku String,
    quantity I32,
    warehouse String,
|
