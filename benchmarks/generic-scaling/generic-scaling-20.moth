    c = Cell(v)
    sum += unwrap(c).slot
    p = Pair(v, Kind0002(1))
    sum += left(p).slot
    sum += right(p).slot
    cells ~{Cell of Kind0001} = {}
    sum += count_cells(cells)
    nest ~{{Cell of Kind0001}} = {}
