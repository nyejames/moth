-- generic-scaling-20.moth
-- Generic instantiation scaling fixture.
--
-- Declares 20 distinct concrete types and drives each through the same seven
-- generic call sites, so every site presents a substitution mapping and a
-- generated-function identity nothing else in the module shares.
--
-- One driver per concrete type, each with the same statement count, so the
-- series grows the instantiation count and holds function body size fixed.
-- That separation matters: a single growing body makes borrow validation
-- quadratic on its own and hides what generics cost.
--
-- The language forbids nested generic applications (MOTH-SYNTAX-0015), so
-- substitution depth is reached with structural wrappers around a single
-- application instead: {Cell of T}, {{Cell of T}}, Pair of A, B.
--
-- One point in the `generic_instantiation` scaling series declared in
-- benchmarks/manifest.toml. Every point uses this identical generated
-- pattern so the series measures size alone.
-- Deterministic pattern; regenerate the whole series rather than hand editing.

-- Generic constructors: one parameter and two parameters.
Cell type T = |
    value T,
|

Pair type A, B = |
    first A,
    second B,
|

-- Generic functions. Each parameter shape wraps one generic application in a
-- different structural nest, so substitution recurses to a different depth.
unwrap type T |cell Cell of T| -> T:
    return cell.value
;

count_cells type T |cells {Cell of T}| -> Int:
    return cells.length()
;

count_nested type T |cells {{Cell of T}}| -> Int:
    return cells.length()
;

left type A, B |pair Pair of A, B| -> A:
    return pair.first
;

right type A, B |pair Pair of A, B| -> B:
    return pair.second
;

-- 20 distinct concrete types: each one is a distinct type argument, so
-- every generic call site below presents a mapping the substitution cache
-- has not seen.
Kind0000 = |
    slot Int,
|

Kind0001 = |
    slot Int,
|

Kind0002 = |
    slot Int,
|

Kind0003 = |
    slot Int,
|

Kind0004 = |
    slot Int,
|

Kind0005 = |
    slot Int,
|

Kind0006 = |
    slot Int,
|

Kind0007 = |
    slot Int,
|

Kind0008 = |
    slot Int,
|

Kind0009 = |
    slot Int,
|

Kind0010 = |
    slot Int,
|

Kind0011 = |
    slot Int,
|

Kind0012 = |
    slot Int,
|

Kind0013 = |
    slot Int,
|

Kind0014 = |
    slot Int,
|

Kind0015 = |
    slot Int,
|

Kind0016 = |
    slot Int,
|

Kind0017 = |
    slot Int,
|

Kind0018 = |
    slot Int,
|

Kind0019 = |
    slot Int,
|

-- Instantiation churn: one small driver per concrete type, so statements
-- per function stay constant and only the type count grows.
drive0000 || -> Int:
    sum ~= 0
    v = Kind0000(0)
    c = Cell(v)
    sum += unwrap(c).slot
    p = Pair(v, Kind0001(0))
    sum += left(p).slot
    sum += right(p).slot
    cells ~{Cell of Kind0000} = {}
    sum += count_cells(cells)
    nest ~{{Cell of Kind0000}} = {}
    sum += count_nested(nest)
    return sum
;

