run_generic_scaling ||:
    io.line("generic scaling start")
    sum ~= 0
    sum += drive0000()
    sum += drive0001()
    sum += drive0002()
    sum += drive0003()
    sum += drive0004()
    sum += drive0005()
    sum += drive0006()
    sum += drive0007()
    sum += drive0008()
    sum += drive0009()
    sum += drive0010()
    sum += drive0011()
    sum += drive0012()
    sum += drive0013()
    sum += drive0014()
    sum += drive0015()
    sum += drive0016()
    sum += drive0017()
    sum += drive0018()
    sum += drive0019()
    io.line([: total=[sum] ])
    io.line("generic scaling complete")
;

run_generic_scaling()
