-- nominal-scaling-320.moth
-- Nominal member scaling fixture.
--
-- Declares 320 structs of six fixed-capacity fields each and 80 choices of three
-- payload variants each, driven by four capacity constants. Constant count is fixed at four
-- at every size, so member-shell construction and capacity fixup cost scale independently of
-- constant resolution cost.
--
-- One point in the `nominal_members` scaling series declared in benchmarks/manifest.toml.
-- Every point uses this identical generated pattern so the series measures size alone.
-- Deterministic pattern; regenerate the whole series rather than hand editing members.

-- Capacity constants: the only compile-time constants in this module.
tiny_capacity #Int = 2
small_capacity #Int = 4
medium_capacity #Int = 8
large_capacity #Int = 16

-- Structs: every field is a fixed-capacity collection keyed by one capacity constant.
Bucket0000 = |
    field0_v {tiny_capacity Int},
    field1_v {small_capacity Float},
    field2_v {medium_capacity String},
    field3_v {large_capacity Bool},
    field4_v {tiny_capacity Int},
    field5_v {small_capacity Float},
|

Bucket0001 = |
    field0_v {small_capacity Bool},
    field1_v {medium_capacity Int},
    field2_v {large_capacity Float},
    field3_v {tiny_capacity String},
    field4_v {small_capacity Bool},
    field5_v {medium_capacity Int},
|

