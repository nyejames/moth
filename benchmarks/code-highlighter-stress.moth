-- Example: long prose comment block
-- This fixture intentionally mixes complete current word groups, planned
-- non-token words, compound operators, numeric forms, strings with escapes,
-- unicode identifiers, function declarations, receiver methods, trait
-- declarations, conformances, generic bounds, directives, import paths,
-- grouped imports, ALL_CAPS constants and plain identifiers so the compile-time
-- formatter exercises every scanning branch in one deterministic workload.
-- The body stays balanced and clean because benchmark cases require a clean
-- compile and the fixture must not become correctness coverage itself.

-- Example: final assertions
assert code_snippet.length() > 0
assert renderer != none
assert total >= 0
assert config.theme != ""

-- Example: closing state
last_value #= 42
last_message #= "done"
]

render || -> String:
    return [code_snippet]
;

[render()]
