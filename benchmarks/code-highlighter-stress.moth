-- code-highlighter-stress.moth
-- Dedicated $code("moth") formatter workload.
-- The balanced directive body below is representative Moth source-like text so
-- the compile-time HTML formatter scans a realistic mix of words, operators,
-- strings, numbers, comments, directives, paths and plain identifiers.

code_snippet #= [$code("moth"):
-- module documentation
import @core/io {print, line, debug}
import @core/math {sin, cos, tan, PI, TAU, E}
import @core/text {length, contains, prefix, suffix}
import @web/canvas {Canvas, draw_rect, fill_circle, stroke_line}
import @project {config, version, build_number}
import @vendor/drawing.js {render_scene, apply_filter}

-- nominal types
Label = |
    text String,
    count Int,
    active Bool,
|

Point type A = |
    x A,
    y A,
|

Box type A = |
    value A,
    next none,
|

Maybe type A ::
    Some | value A, |,
    Empty,
;

Color ::
    Red,
    Green,
    Blue,
    Rgb | red Float, green Float, blue Float, |,
;

Status ::
    Ready,
    Running | progress Float, |,
    Failed | message String, code Int, |,
;

-- traits and conformances
DISPLAY_TEXT must:
    display |this Label| -> String
;

SERIALIZABLE must:
;

COMPARABLE must:
    compare |this Label, other Label| -> Int
;

FROZEN must:
;

Label must DISPLAY_TEXT
Label must SERIALIZABLE and COMPARABLE
Point must not FROZEN
Color must SERIALIZABLE

-- generic bounds
identity type A is SERIALIZABLE |value A| -> A:
    return value
;

-- functions
render |title String, lines Int| -> String:
    if lines is:
        0 => return ""
        1 => return title
        else => return title + "!"
    ;
;

paint |canvas Canvas, color Color| -> Bool:
    canvas.prepare()
    draw_rect(canvas, 10, 20, 30, 40)
    fill_circle(canvas, 5.5, 6.5, 1.0e2)
    stroke_line(canvas, 0, 0, 100, 100)
    return true
;

parse |source String| -> Maybe Int:
    catch number = Int.from_text(source)
    return Some(number)
;

total |values {Int}| -> Int:
    copy sum = 0
    for value in values:
        sum += value
    return sum
;

-- receiver methods
display |this Label| -> String:
    return this.text
;

compare |this Label, other Label| -> Int:
    if this.count is:
        other.count => return 0
        less => return -1
        else => return 1
    ;
;

scale |this Point Float| -> Point Float:
    copy value = this.x * 2.0
    return Point(value, this.y * 2.0)
;

push |this {Int}, value Int|:
    this += value
;

-- constants and literal values
page_title #= "Highlighter stress"
max_attempts #= 1_000
step #= 1.5
rate #= 1e6
precision #= 1e-6
limit #= 1.0e+21
enabled #= true
disabled #= false
missing #= none
empty_name #= ""
single_char #= 'z'
newline #= "\n"
quote #= "say \"hello\""
unicode_name #= "héllo"
greek_name #= "π ≈ 3.14159"
cjk_name #= "名前"
lambda #= 'λ'
cyrillic #= "Здравствуйте"

-- numeric forms
integer_value #= 42
separated_value #= 12_345_678
fraction_value #= 3.25
small_exponent #= 2e8
negative_exponent #= 4e-9
mixed_exponent #= 7.5e+12
largest_exponent #= 1.0e+21

-- compound assignment and declaration forms
total //= 1
total += 2
total -= 1
total *= 3
total /= 2
total %= 5
total ^= 2
mask #= 0
value ~= 2
budget $= 100

-- structural and control forms
match status:
    Ready => io.line("ready")
    Running | progress, | if progress >= 0.5 => io.line("almost")
    else => io.line("waiting")
;

render -> String:
    return title
;

Maybe type A ::
    Some | value A, |,
    Empty,
;

range 1..10
shifted >> 2
shifted << 1
remainder // 3
score <= 100
score >= 0
equal = value
plus = a + b
minus = a - b
star = a * b
slash = a / b
percent = a % b
caret = a ^ b
less = a < b
greater = a > b
tilde ~ place
hash # marker
dollar $ marker
bang ! handled
question ?
ampersand &
at @ core

-- explicit exclusions stay plain
in_value = 1
fn_value = 2
group_value = 3
into_value = 4
where_value = 5

-- deferred reserved words use keyword style
async_task #= true
yield_point #= 0
checked_mode #= true
block_scope #= false

-- attached bang forms
return! value
cast! value
catch error!:

-- strings and characters with escapes
escaped = "tab\there"
unicode_escape = "\u0041"
char_escape = '\n'
combined = "line one\nline two"
nested_quote = 'it\'s'

-- line comments
-- a comment with keywords if return loop to by
-- a comment with operators //= += -= and paths @core/io

-- template examples with directives
markdown_block #= [$md:
    # Heading

    Paragraph with **emphasis** and @./other-page (a link).
]

code_block #= [$code("moth"):
    value = 42
]

page_wrapper #= [$children(:<div class="card">[$slot]</div>):
    <article>[$slot]</article>
]

named_slot #= [$slot("title")]
insert_block #= [$insert("aside"): sidebar text]
raw_block #= [$raw: <b>kept</b>]
html_block #= [$html: <main class="content"></main>]
css_block #= [$css: .card { border: 1px solid; }]
escape_block #= [$escape_html: <div>&</div>]
fresh_child #= [$fresh]

-- grouped imports and aliases
import @core/io {print as log, line as write_line}
import @core/collections {Map, map_from}
import @core/time {Duration, Timestamp}
import @core/random {random_float, random_int}

-- module structure
export:
    render
    paint
    parse
    total
    Label
    Point
    Maybe
    Color
    Status
;

-- control flow
if enabled:
    io.line("enabled")
else if disabled:
    io.line("disabled")
else:
    io.line("unknown")
;

while attempts < max_attempts:
    attempts += 1
;

loop:
    break
;

for index to 10 by 2:
    io.line(index)
;

for name in names:
    if name is:
        "stop" => break
        "skip" => continue
        else => io.line(name)
    ;
;

-- error handling
read_file |path String| -> String:
    catch content = File.read(path)
    return content
;

-- choices and pattern matching
describe |color Color| -> String:
    match color:
        Red => return "red"
        Green => return "green"
        Blue => return "blue"
        Rgb | red, green, blue, | => return "rgb"
    ;
;

-- option handling
first |values {Int}| -> Maybe Int:
    if values:
        return Some(values[0])
    return Empty
;

-- mutable access
set_name |this Label, name String|:
    ~this.text = name
;

-- collections
numbers #= {1, 2, 3, 4, 5}
names #= {"Priya", "Rob", "Emmy", "Huw"}
scores #= {"alpha" = 10, "beta" = 20, "gamma" = 30}
nested #= { {1, 2}, {3, 4}, {5, 6} }

-- loops over collections
sum_all |values {Int}| -> Int:
    copy result = 0
    for value in values:
        result += value
    return result
;

-- generic functions
identity type A |value A| -> A:
    return value
;

pair type A, B = |
    first A,
    second B,
|

-- aliases
type Name = String
type Index = Int
type Lookup = {String = Int}

-- casts
as_int = value as Int
as_float = value as Float
as_string = value as String
cast_value = cast! value
return_value = return! value

-- assertions
assert enabled
assert count > 0
assert name != ""

-- this and This
describe |this Label| -> String:
    return this.text
;

trait_method |This| -> String:
    return "trait method"
;

-- async and yield deferred forms
async load |url String| -> String:
    yield result
    return result
;

-- operators in expressions
sum = a + b - c * d / e % f
bitwise = a ^ b
shifts = (a << 2) + (b >> 1)
comparisons = a < b and b <= c or c >= d
equality = a is b
inequality = a not b
logical = enabled and not disabled or pending
range_check = value in bounds
contains_check = item in collection
access = map[key]
projection = object.field
method_call = object.render()
chain = object.transform().render()

-- ALL_CAPS constants stay plain outside contract context
PI #= 3.14159
TAU #= 6.28318
E #= 2.71828
MAX_SIZE #= 1024
MIN_DELAY #= 0.05
DEFAULT_COLOR #= "blue"
CONFIG_PATH #= "@project/config"

-- trait requirements
SHAPE must:
    area |this| -> Float
    perimeter |this| -> Float
;

DRAWABLE must:
    draw |this, canvas Canvas| -> Bool
;

-- conformance with lists
Circle must SHAPE and DRAWABLE
Square must SHAPE
Polygon must SHAPE and COMPARABLE and SERIALIZABLE

-- generic parameter bounds
sort type A is COMPARABLE |values {A}| -> {A}:
    return values
;

-- struct construction and fields
label #= Label("hello", 3, true)
origin #= Point(0, 0)
origin_f #= Point(0.0, 0.0)
boxed #= Box(42, none)
maybe_int #= Maybe.Some(7)
maybe_empty #= Maybe.Empty
color #= Color.Rgb(1.0, 0.5, 0.25)
status #= Status.Running(0.75)

-- field access
title_text = label.text
label_count = label.count
is_active = label.active
origin_x = origin.x
origin_y = origin.y

-- method calls
rendered = label.display()
comparison = label.compare(other)
scaled = origin.scale(2.0)
pushed = numbers.push(6)

-- namespace access
io.line("hello")
io.print("world")
io.debug("trace")
math.sin(1.0)
math.cos(0.5)
text.length("hello")
text.contains("hello", "ell")

-- plain variables and fields stay unwrapped
ordinary_value = 1
another_value = ordinary_value + 1
local_field = label_count
temporary = rendered

-- deep nesting for scanner pressure
deep_a = ((((1 + 2) * (3 - 4)) / (5 % 6)) ^ (7 << 1)) + (8 >> 2)
deep_b = (a + (b * (c - (d / (e % f))))) - ((g << 2) + (h >> 1))
deep_c = "prefix" + "middle" + "suffix" + "tail"
deep_d = if enabled then "yes" else "no"
deep_e = point.x + point.y + point.z + point.w

-- repeated realistic declarations for scan volume
article_1 #= "First article"
article_2 #= "Second article"
article_3 #= "Third article"
article_4 #= "Fourth article"
article_5 #= "Fifth article"
article_6 #= "Sixth article"
article_7 #= "Seventh article"
article_8 #= "Eighth article"
article_9 #= "Ninth article"
article_10 #= "Tenth article"

section_1 #= "Introduction"
section_2 #= "Background"
section_3 #= "Methods"
section_4 #= "Results"
section_5 #= "Discussion"
section_6 #= "Conclusion"
section_7 #= "References"
section_8 #= "Appendix"

-- helper functions with mixed bodies
validate |value Int| -> Bool:
    if value < 0 or value > 100:
        return false
    return true
;

classify |score Float| -> String:
    if score >= 90.0:
        return "excellent"
    else if score >= 75.0:
        return "good"
    else if score >= 50.0:
        return "pass"
    return "fail"
;

format |values {String}| -> String:
    copy parts = ""
    for index to values.length() by 1:
        if index > 0:
            parts += ", "
        parts += values[index]
    return parts
;

-- runtime template fragments
header #= [: <h1>[title]</h1> ]
footer #= [: <footer>[version]</footer> ]
card #= [: <div class="card">[label.text]</div> ]
list_item #= [: <li>[name]</li> ]

-- reactive markers
count $= 0
@count + 1
[$count]
[$name]

-- imports with paths and resources
import @core/io {print}
import @web/canvas {Canvas}
import @project/config {theme}
import @vendor/assets/logo.png

-- long plain identifier runs
configuration_default_cache_size = 1024
configuration_default_timeout_ms = 30_000
configuration_default_retry_limit = 5
rendered_document_cache_key = "docs/index"
generated_output_directory_name = "release"

-- numeric edge forms
