-- keyword usage in realistic statements
if ready and not busy or pending:
    start_work()
else:
    queue_work()
;

while running:
    step()
;

loop:
    poll()
    if done:
        break
;

for item in items:
    process(item)
;

for index to limit by step:
    advance(index)
;

assert ready
assert value is not none
assert index >= 0 and index < length

-- type usage in signatures
convert |value String| -> Int:
    return value as Int
;

convert |value Int| -> Float:
    return value as Float
;

convert |value Float| -> String:
    return value as String
;

-- builtin singleton types
empty_text #= None
empty_optional #= none
positive #= True
negative #= False
error_value #= Error
error_message #= Error("failed")

-- receiver chains
result = pipeline.transform().validate().render()
output = builder.set_title("Docs").set_theme("dark").build()
count = words.filter(is_long).count()
value = config.get("theme").or_default("light")

-- function declarations with parameters
greet |name String| -> String:
    return "Hello, " + name
;

add |a Int, b Int| -> Int:
    return a + b
;

multiply |a Float, b Float| -> Float:
    return a * b
;

divide |a Float, b Float| -> Float:
    assert b != 0.0
    return a / b
;

-- nested control flow
process_all |values {Int}| -> Int:
    copy total = 0
    for value in values:
        if value is 0:
            continue
        if value < 0:
            break
        total += value
    return total
;

-- error propagation with catch
load_config |path String| -> config:
    catch data = File.read(path)
    catch parsed = parse_config(data)
    return parsed
;

-- mutable state
counter = 0
~counter += 1
~counter = counter * 2
~counter -= 1

-- shared access
copy first = label
copy second = label
io.line(first.text)
io.line(second.text)

-- explicit copies
copy independent = label
~independent.text = "changed"

-- collection operations
values.push(1)
values.push(2)
values.remove(0)
values.length()
map.insert("key", 1)
map.get("key")
map.remove("key")

-- range loops
for index to 10:
    io.line(index)
;

for index to 100 by 10:
    io.line(index)
;

for index to 1_000 by 100:
    io.line(index)
;

-- pattern matching with guards
match result:
    Some | value, | if value > 0 => io.line(value)
    Some | value, | => io.line(-value)
    Empty => io.line("none")
;

-- trait method dispatch
display_text = label.display()
compare_result = label.compare(other_label)
area_result = circle.area()
perimeter_result = circle.perimeter()
draw_result = circle.draw(canvas)

-- generic instantiation
int_box #= Box(7)
float_box #= Box(1.5)
string_box #= Box("value")
int_pair #= Pair(1, 2)
float_pair #= Pair(1.0, 2.0)
mixed_pair #= Pair("name", 42)

