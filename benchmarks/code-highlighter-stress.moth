-- Example: status handling
handle |status Status| -> String:
    match status:
        Ready => return "ready"
        Running | progress, | => return "running at " + progress
        Failed | message, code, | => return message + " (" + code + ")"
    ;
;

-- Example: option composition
compose |a Maybe Int, b Maybe Int| -> Maybe Int:
    match a:
        Empty => return Empty
        Some | x, | => match b:
            Empty => return Empty
            Some | y, | => return Some(x + y)
    ;
;

