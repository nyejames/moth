-- project modules and packages
project #= {
    name = "highlight-stress",
    version = "0.1.0",
    entry_root = "src",
    builder = "html",
}

config #= {
    theme = "dark",
    accent = "#fdbe82",
    code_font_size = "0.95rem",
}

-- application entry
start:
    io.line("starting")
    render_main_page()
    io.line("finished")
;

render_main_page || -> String:
    copy title = "Dashboard"
    copy body = "Welcome"
    return [:
        <html>
            <head><title>[title]</title></head>
            <body><main>[body]</main></body>
        </html>
    ]
;

