-- constant-chain-512.moth
-- Constant-count scaling fixture: 512 dependency-ordered constants.
--
-- Every constant uses the same tiny initializer shape `c<i> #= c<i-1> + 1`, so the
-- only variable across the 32/128/512 fixtures is how many constants the module
-- constant pass has to set up and fold. Per-constant setup cost is therefore visible
-- as curvature between the three sizes rather than as fold complexity.
--
-- Deterministic pattern; regenerate by repeating the initializer line, do not hand edit.


c000 #= 1
c001 #= c000 + 1
c002 #= c001 + 1
c003 #= c002 + 1
c004 #= c003 + 1
