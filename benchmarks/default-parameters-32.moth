-- default-parameters-32.moth
-- Signature default stress test:
-- - 32 functions, each with an arithmetic I32 default and a String default
-- - Every call omits both arguments, so each call site fills two defaults

default_00 |count I32 = (0 + 1) * 2, label String = "item-00"| -> String:
    return [: [label]:[count]]
;

