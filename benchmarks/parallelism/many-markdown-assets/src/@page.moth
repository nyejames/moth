@docs/intro
@docs/setup
@docs/usage
@docs/api
@docs/faq
@docs/release
@docs/notes
@docs/summary

intro_content #String = intro.content
setup_content #String = setup.content
usage_content #String = usage.content
api_content #String = api.content
faq_content #String = faq.content
release_content #String = release.content
notes_content #String = notes.content
summary_content #String = summary.content

[:
    <main>
        [intro_content]
        [setup_content]
        [usage_content]
        [api_content]
        [faq_content]
        [release_content]
        [notes_content]
        [summary_content]
    </main>
]
