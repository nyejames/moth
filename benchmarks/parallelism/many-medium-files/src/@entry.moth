@sections/alpha render_alpha
@sections/beta render_beta
@sections/gamma render_gamma
@sections/delta render_delta
@sections/epsilon render_epsilon
@sections/zeta render_zeta
@sections/eta render_eta

[:
    <main>
        [render_alpha()]
        [render_beta()]
        [render_gamma()]
        [render_delta()]
        [render_epsilon()]
        [render_zeta()]
        [render_eta()]
    </main>
]
