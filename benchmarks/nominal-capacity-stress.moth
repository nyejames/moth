-- nominal-capacity-stress.moth
-- Capacity-dependent nominal member fixture.
--
-- Four capacity constants drive several hundred fixed-capacity struct fields and
-- choice payload fields. Constant count stays fixed while member count grows, so
-- member-shell construction and capacity fixup cost can be attributed separately
-- from constant resolution cost.
--
-- Deterministic pattern; regenerate rather than hand editing individual members.

-- Capacity constants: the only compile-time constants in this module.
tiny_capacity #Int = 2
small_capacity #Int = 4
medium_capacity #Int = 8
large_capacity #Int = 16

-- Structs: every field is a fixed-capacity collection keyed by one capacity constant.
Bucket00 = |
    field0_int {tiny_capacity Int},
    field1_float {small_capacity Float},
    field2_string {medium_capacity String},
    field3_bool {large_capacity Bool},
    field4_int {tiny_capacity Int},
    field5_float {small_capacity Float},
|

Bucket01 = |
    field0_string {small_capacity String},
    field1_bool {medium_capacity Bool},
    field2_int {large_capacity Int},
    field3_float {tiny_capacity Float},
    field4_string {small_capacity String},
    field5_bool {medium_capacity Bool},
|

