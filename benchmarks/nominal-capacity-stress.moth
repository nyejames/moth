-- Choices: capacity-dependent payload fields exercise the variant member path.
Signal00 ::
    Idle,
    Batch0 | items {tiny_capacity Int}, tag String |,
    Batch1 | items {small_capacity Float}, tag String |,
    Batch2 | items {medium_capacity String}, tag String |,
;

