debug/
tmp/
target/
docs/_dev/
docs/_release/
test_output/
benchmarks/local-data/
benchmarks/old-benchmarks/
benchmarks/results/

# Benchmark build outputs
benchmarks/**/_dev/
benchmarks/**/_release/

**/*.rs.bk
*.pdb

# Ignore all hidden files
.*

# But allow project metadata, the validation Node pin and GitHub Actions
!.gitignore
!.gitattributes
!/.node-version
!.github/
!.github/workflows/**

# These are created by compiler test files sometimes, and can be ignored
/test.html
/index.html

# Integration golden snapshots should remain versionable even when they
# contain index.html artifacts.
!tests/cases/**/golden/**

# Integration fixture build outputs
tests/cases/**/input/_dev/
tests/cases/**/input/_release/
