@aliases docs_alias

-- The direct reference, the imported alias, and the formatting-whitespace contribution all
-- resolve to one stable resource origin and emit one link. A and B have identical bytes but
-- distinct origins, so they remain separate links.

[$in stylesheets: [@site_styles/docs.css]]
[$in stylesheets: [docs_alias]]
[$in stylesheets:
    [@site_styles/docs.css]
]
[$in stylesheets: [@site_styles/a.css]]
[$in stylesheets: [@site_styles/b.css]]

[:<main>stylesheets body</main>]
