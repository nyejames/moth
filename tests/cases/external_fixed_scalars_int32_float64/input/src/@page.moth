-- Fixed-width results keep their own destination precision and finite validation:
-- the glue forwards each raw host `F32` payload and the shared HIR float guard
-- rounds it once at binary32, preserves signed zero and subnormals, and rejects a rounded
-- non-finite value with code 304 through a declared builtin Error! boundary.
@fixed_scalars.js identity_u32, load_u32, identity_f32, load_f32, overflow_f32, raw_f32, identity_int, identity_uint, identity_float

is_max_u32 |value U32| -> Bool:
    return value is 4294967295
;

is_tenth_f32 |value F32| -> Bool:
    expected F32 = 0.1
    return value is expected
;

zero U32 = identity_u32(0)
maximum U32 = identity_u32(4294967295)
loaded U32 = load_u32() catch:
    then 0
;
fraction F32 = identity_f32(0.1)
rounded F32 = load_f32() catch:
    then 0.0
;
-- The glue forwards the raw host payload, so the shared float guard needs a declared builtin
-- `Error!` receiving boundary: this helper owns the guard's recoverable 304 delivery, while the
-- synthetic entry's own float integrity guard stays trap-only.
overflow_boundary || -> F32, Error!:
    return overflow_f32()!
;

boundary_code ~U32 = 0
recovered F32 = overflow_boundary() catch |boundary_error|:
    boundary_code = boundary_error.code
    then 0.0
;
maximum_matches = is_max_u32(maximum)
loaded_matches = is_max_u32(loaded)
fraction_matches = is_tenth_f32(fraction)
rounded_matches = is_tenth_f32(rounded)
native_int I32 = identity_int(17)
native_uint U32 = identity_uint(18)
native_float F64 = identity_float(1.5)

f32_classify |value F32| -> U32:
    expected_half F32 = 1.5
    expected_tenth F32 = 0.1
    expected_zero F32 = 0.0
    if value is expected_half:
        return 1
    ;
    if value is expected_tenth:
        return 2
    ;
    if value is expected_zero:
        return 3
    ;
    if value > expected_zero:
        return 4
    ;
    if value < expected_zero:
        return 5
    ;
    return 6
;

-- The raw payload host function needs the same declared builtin `Error!` receiving boundary, so
-- the no-slot classification helpers below keep observing code 304 instead of trapping.
raw_f32_boundary |selector U32| -> F32, Error!:
    return raw_f32(selector)!
;

f32_class |selector U32| -> U32:
    value F32 = raw_f32_boundary(selector) catch:
        then 0.0
    ;
    return f32_classify(value)
;

f32_failure |selector U32| -> U32:
    failure ~U32 = 0
    value F32 = raw_f32_boundary(selector) catch |err|:
        failure = err.code
        then 0.0
    ;
    return failure
;

f32_half = f32_class(1)
f32_tenth = f32_class(2)
f32_large = f32_class(3)
f32_subnormal = f32_class(5)
f32_zero = f32_class(9)
f32_overflow_code = f32_failure(4)
f32_nan_code = f32_failure(6)
f32_positive_inf_code = f32_failure(7)
f32_negative_inf_code = f32_failure(8)
[:fixed scalar zero=[zero] maximum=[maximum_matches] loaded=[loaded_matches] f32=[fraction_matches]/[rounded_matches] overflow=[boundary_code] native=[native_int]/[native_uint]/[native_float] raw=[f32_half]/[f32_tenth]/[f32_large]/[f32_subnormal]/[f32_zero] codes=[f32_overflow_code]/[f32_nan_code]/[f32_positive_inf_code]/[f32_negative_inf_code]]
