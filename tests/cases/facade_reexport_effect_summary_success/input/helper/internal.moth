-- Ordinary implementation file private to the helper module.
-- The facade (@mod.moth) re-exports these declarations across the module boundary.

Counter = |
    step Int,
|

-- Returns an alias of the shared parameter. Aliasing is inferred from the return expression.
alias_of |value Counter| -> Counter:
    return value
;

-- Returns a fresh, independently owned value.
fresh_counter || -> Counter:
    return Counter(0)
;

-- Mutates an existing mutable place passed by the caller.
bump |value ~Counter|:
    value.step = value.step + 1
;
