Link = |items {I32}|

wrap_option |maybe {I32}?, retain Bool| -> Link:
    if retain:
        if maybe is |present|:
            return Link(present)
        ;
    ;
    return Link({2, 3})
;

probe |retain Bool| -> I32:
    child ~= {1}
    observer ~= Link(child)
    source ~{I32}? = child
    result ~= wrap_option(source, retain)
    ~result.items.push(2)
    return result.items.length() * 10 + observer.items.length()
;

~[:[probe(true)] / [probe(false)]]
