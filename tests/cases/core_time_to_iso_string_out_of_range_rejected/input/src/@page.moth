@core/time Timestamp, timestamp_from_unix_milliseconds, to_iso_string

render_past_window || -> Int, Error!:
    -- One millisecond past 9999-12-31T23:59:59.999Z, the last renderable instant
    far = timestamp_from_unix_milliseconds(253402300800000.0)
    iso = to_iso_string(far)!
    return 0
;

render_fractional_edge || -> Int, Error!:
    -- Half a millisecond past the window: the range is tested before truncation
    edge = timestamp_from_unix_milliseconds(253402300799999.5)
    iso = to_iso_string(edge)!
    return 0
;

past_code ~U32 = 0
past_value = render_past_window() catch |past_err|:
    past_code = past_err.code
    then 0
;

edge_code ~U32 = 0
edge_value = render_fractional_edge() catch |edge_err|:
    edge_code = edge_err.code
    then 0
;

[: to_iso_string_out_of_range code=[past_code] edge_code=[edge_code]]
