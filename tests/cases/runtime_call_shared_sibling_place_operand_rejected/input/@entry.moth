-- Borrow checking is root-granular: mutating `pair.right` conflicts with the
-- still-needed `pair.left` read, the same verdict as binding `left = pair.left`
-- first. Field-precise disjointness is deferred (see BC-06).
Pair = |left {I32}, right {I32}|

inspect |items {I32}, count I32| -> I32:
    return items.length() * 10 + count
;

replace_right |items ~{I32}| -> I32:
    ~items.push(5)
    return items.length()
;

pair ~= Pair({1}, {2})
result = inspect(pair.left, replace_right(~pair.right))
~[:[result]]
