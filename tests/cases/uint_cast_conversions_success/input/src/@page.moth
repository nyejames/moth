-- Task 2B: the Conversions-table rows for U32: exact-width,
-- fixed-float, Dec-boundary and text pairs (U32<->Byte/Char/Bool have no
-- evidence; see uint_cast_failures_rejected). Fallible pairs use handled
-- casts; infallible pairs use plain cast.
@helpers try_to_i32

uint_to_int |value U32| -> I32, Error!:
    return cast value
;

int_to_uint |value I32| -> U32, Error!:
    return cast value
;

float_to_uint |value F64| -> U32, Error!:
    return cast value
;

f32_to_uint |value F32| -> U32, Error!:
    return cast value
;

uint_to_float |value U32| -> F64:
    return cast value
;

narrow_from_uint |value U32| -> U8, Error!:
    return cast value
;

narrow_to_uint |value U8| -> U32:
    return cast value
;

uint_to_scaled |value U32| -> Dec2:
    return cast value
;

scaled_to_uint |value Dec2| -> U32, Error!:
    return cast value
;

text_to_uint |text String| -> U32, Error!:
    return cast text
;

uint_to_text |value U32| -> String:
    return cast value
;

small_int I32 = 41
small_uint U32 = int_to_uint(small_int) catch:
    then 0
;
neg_uint U32 = int_to_uint(-7) catch:
    then 1
;
back_int I32 = uint_to_int(small_uint) catch:
    then -1
;
big_back I32 = uint_to_int(4294967295) catch:
    then -2
;

-- Task 2B: U32 proves TRY_CASTABLE_TO_I32 through the core-trait path.
generic_back I32 = try_to_i32(small_uint) catch:
    then -3
;

neg_half U32 = float_to_uint(-0.5) catch:
    then 100
;
neg_one U32 = float_to_uint(-1.0) catch:
    then 101
;
truncated U32 = float_to_uint(7.9) catch:
    then 104
;

as_float F64 = uint_to_float(3000000001)
as_text String = uint_to_text(3000000001)
parsed U32 = text_to_uint("42") catch:
    then 0
;
parsed_neg_zero U32 = text_to_uint("-0") catch:
    then 7
;
parsed_bad U32 = text_to_uint("4a") catch:
    then 8
;

wide U32 = 3000000001
back_wide U32 = 4000000000
narrowed U8 = narrow_from_uint(200) catch:
    then 0
;
narrow_fail U8 = narrow_from_uint(300) catch:
    then 9
;
widened U32 = narrow_to_uint(250)

scaled Dec2 = uint_to_scaled(123)
scaled_back U32 = scaled_to_uint(123.00) catch:
    then 0
;
scaled_fraction U32 = scaled_to_uint(123.45) catch:
    then 11
;
scaled_range U32 = scaled_to_uint(9999999999.00) catch:
    then 12
;
f32_truncated U32 = f32_to_uint(7.9) catch:
    then 13
;
max_const #U32 = 4294967295
max_dec Dec2 = uint_to_scaled(max_const)
max_decimal #Dec2 = 4294967295.00
next_decimal #Dec2 = 4294967296.00
max_is_dec Bool = max_const is max_decimal
max_less_dec Bool = max_const < next_decimal

[:uint casts int=[small_uint]/[neg_uint]/[back_int]/[big_back]/[generic_back] float=[neg_half]/[neg_one]/[truncated]/[as_float] fixed32=[f32_truncated] text=[as_text]/[parsed]/[parsed_neg_zero]/[parsed_bad] fixed=[wide]/[back_wide]/[narrowed]/[narrow_fail]/[widened] dec=[scaled]/[scaled_back]/[scaled_fraction]/[scaled_range]/[max_dec]/[max_is_dec]/[max_less_dec]]
