-- Shared aliases of one immutable binding all stay readable, and a mutable
-- binding rebinds from its own previous value. Each alias and the rebound
-- counter is named and independently observable in one top-level output event.

data = "test data"

result = data
ref1 = data
ref2 = data

counter ~= 0
counter = counter + 1

[:borrow_checker_basic_variables result=[result] ref1=[ref1] ref2=[ref2] counter=[counter]]
