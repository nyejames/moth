-- `child` is a mutable alias of the same storage as `parent`. Reading the source alias while
-- the child remains live is a foreign access, even though the reader is an alias itself.

probe || -> I32:
    slot ~= {1}
    parent ~= slot
    child ~= parent
    n = parent.length()
    ~child.push(2)
    return n
;

result = probe()
io.line([: [result]])
