-- Raw whole literals and literal expressions take the immediate F64 receiver.
-- This is contextual literal typing, not an implicit conversion from a bound I32.

-- A whole literal takes the receiving domain.
literal F64 = 1

-- A literal expression takes the receiving domain.
expr F64 = 1 + 1

-- A negated whole literal takes the receiving domain.
neg F64 = -5

io.line("float declarations from int passed")
