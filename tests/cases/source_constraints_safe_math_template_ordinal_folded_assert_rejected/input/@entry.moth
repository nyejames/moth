-- The folded assertion lowers as a runtime check, so the template loop stays live and its
-- generated ordinal update is selected source. Both profiles must reject the fast guard.
always_false || -> Bool:
    return false
;

$fast_math $safe_math
render_loop |limit I32| -> String:
    assert(always_false())
    return [: [loop 0 to limit |item, index|:<p>[index]</p>;] ]
;

~[render_loop(2)]
