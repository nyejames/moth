-- Alias chains, template reads and branch-scoped aliases combined: reading an
-- alias inside a template does not keep it live afterwards, an alias created
-- inside a branch does not outlive the branch, and a mutable binding can be
-- rebound after the last shared read on each side. Every value that proves one
-- of those steps is named in one output event.

render_complex_borrowing || -> String:
    user_name = "Bob"
    user_score ~= 100
    user_active = true

    name_ref1 = user_name
    name_ref2 = name_ref1
    name_ref3 = name_ref2

    welcome_msg = [:[name_ref1] welcome]
    status_msg = [:[name_ref2] is active]

    name_ref4 = name_ref3

    scope_msg ~= [:no branch]
    if user_active:
        local_name_ref = name_ref4
        local_score_ref = user_score
        scope_msg = [:[local_name_ref] has score [local_score_ref]]
        user_score = user_score + 10
    ;

    final_name = name_ref1
    final_score = user_score

    return [:complex_borrowing_scenarios welcome=[welcome_msg] status=[status_msg] scope=[scope_msg] final_name=[final_name] final_score=[final_score]]
;

[:[render_complex_borrowing()]]
