export:
    LABELED must:
        label |This| -> String
    ;

    Label = |
        text String,
    |

    make_label |text String| -> Label:
        return Label(text)
    ;

    show type Item is LABELED |item Item| -> String:
        return item.label()
    ;
;

label |this Label| -> String:
    return this.text
;
