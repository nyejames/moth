@large big,
    above

-- Values above i64::MAX stay exact in the 64-bit profile, including across
-- module imports and concrete generic instantiation.
huge Uint = 18446744073709551615
above_signed Uint = 9223372036854775808
max_signed Int = 9223372036854775807

identity type T |value T| -> T:
    return value
;

Box type T = |
    value T,
|

passed Uint = identity(big)
reboxed Box of Uint = Box(above)

passed_big Uint = passed
reboxed_value Uint = reboxed.value

[:uint int64 huge=[huge] above=[above_signed] maxsigned=[max_signed] imported=[big]/[above] generic=[passed_big] boxed=[reboxed_value]]
