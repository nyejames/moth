-- Optional cast receivers convert inner T and wrap the result. This helper
-- converts a runtime parameter and recovers 42 before the normal I32? wrap.

parse_optional |text String| -> I32?:
    return cast text catch then 42
;

maybe I32? = parse_optional("not a number")
assert(maybe is 42)

text = if maybe is |value| then value else -1
[: optional cast catch: [text]]
