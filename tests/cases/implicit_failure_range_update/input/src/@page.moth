walk |start I32, end I32, step I32| -> I32:
    seen ~I32 = 0
    loop start to end by step |value|:
        seen = copy value
    ;
    return seen
;
safe_walk |start I32, end I32, step I32| -> I32, Error!:
    return walk(start, end, step)
;
endpoint || -> I32:
    visited ~I32 = 0
    loop 2147483645 to & 2147483647 |value|:
        visited = visited + 1
    ;
    return visited
;
safe_endpoint || -> I32, Error!:
    return endpoint()
;
code ~U32 = 0
failed = safe_walk(10, 0, -2147483648) catch |overflow_error|:
    code = overflow_error.code
    then 0
;
visited = safe_endpoint() catch then -1

[: range update code=[code] failed=[failed] visited=[visited]]
