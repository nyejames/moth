-- Task 3 under I32/F32: U32 boundary values execute through the
-- shared Number-carrier helpers with unsigned bounds, U32/I32 comparisons
-- stay exact in both directions, and explicit U32 returns convert at F32
-- precision with direct rounding.

add_wide |a U32, b U32| -> U32, Error!:
    return a + b
;

mul_wide |a U32, b U32| -> U32, Error!:
    return a * b
;

sub_wide |a U32, b U32| -> U32, Error!:
    return a - b
;

just_below U32 = add_wide(2147483647, 0) catch:
    then 0
;
just_above U32 = add_wide(2147483648, 1) catch:
    then 0
;
top U32 = add_wide(4294967295, 0) catch:
    then 0
;
top_plus_one U32 = add_wide(4294967295, 1) catch:
    then 7
;
zero_minus_one U32 = sub_wide(0, 1) catch:
    then 9
;
boundary_product U32 = mul_wide(65535, 65537) catch:
    then 0
;
large_product U32 = mul_wide(100000, 100000) catch:
    then 8
;

wide_below |edge U32, limit I32| -> Bool, Bool:
    return limit < edge, edge > limit
;

low_before Bool, low_after Bool = wide_below(2147483648, 2147483647)
neg_before Bool, neg_after Bool = wide_below(0, -1)
top_before Bool, top_after Bool = wide_below(4294967295, -1)

-- Explicit U32 returns convert at the F32 declared precision: 16777217
-- rounds to 16777216, exactly as the explicit cast of a runtime U32 and the
-- folded constants.
converted_to_float |value U32| -> F32:
    return cast value
;

explicit_to_float |value U32| -> F32:
    return cast value
;

converted_big F32 = converted_to_float(16777217)
explicit_big F32 = explicit_to_float(16777217)
folded_big #U32 = 16777217
rounded_big #F32 = cast folded_big
comparison_float #F32 = 16777216.0
folded_eq #Bool = rounded_big is comparison_float
dynamic_eq Bool = converted_big is comparison_float
explicit_eq Bool = explicit_big is comparison_float

-- Compound failure stores nothing and reports through catch and Error!.
accumulate |target ~U32, delta U32| -> U32, Error!:
    ~target += delta
    return target
;

growing ~U32 = 4294967291
grown U32 = accumulate(~growing, 5) catch:
    then 11
;

failing |value U32| -> U32, Error!:
    return sub_wide(value, 1)!
;

recovered U32 = failing(0) catch |recovery_err|:
    then 13
;

-- Folded and dynamic evaluation of the same boundary value agree.
folded_top #U32 = 4294967295
folded_top_kept U32 = folded_top + 0
dynamic_top U32 = add_wide(4294967295, 0) catch:
    then 0
;
folded_dynamic_agree Bool = folded_top_kept is dynamic_top

[:uint float32 wide=[just_below]/[just_above]/[top]/[top_plus_one]/[zero_minus_one] prod=[boundary_product]/[large_product] compare=[low_before]/[low_after]/[neg_before]/[neg_after]/[top_before]/[top_after] converted=[converted_big]/[explicit_big]/[folded_eq]/[dynamic_eq]/[explicit_eq] compound=[growing]/[grown]/[recovered] agree=[folded_dynamic_agree]]
