inactive_branch || -> String, Error!:
    return! Error("inactive branch evaluated", 500)
;

render_selected |selected Bool| -> String:
    return [if selected:
        selected lazy branch
    ]
;

selected_result = render_selected(true)

render_fallible |should_render Bool| -> String, Error!:
    return [if should_render:
        [inactive_branch()!]
    ]
;

inactive_result = render_fallible(false) catch:
    then "caught inactive branch"
;

[:template_control_flow_runtime_laziness [selected_result] [inactive_result]]
