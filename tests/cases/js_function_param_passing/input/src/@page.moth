-- Test that function parameters are normalized through __moth_param_binding
-- and that call arguments use the reference ABI (__moth_binding wrapping).

double |n I32| -> I32:
    return n * 2
;

identity |value I32| -> I32:
    return value
;

x = 5
result1 = double(x)
result2 = identity(42)
io.line([: [result1]])
io.line([: [result2]])
