-- The direct U64 parameter receiver selects the shared numeric origin.
-- The push/get cycle has no binding-mediated witness.

read_u64 |value U64| -> U64:
    return value
;

render || -> String, Error!:
    values ~= {1}
    ~values.push(values.get(0)! + 1)
    inline_text String = cast read_u64(values.get(0)!)
    scores = {1 = 3}
    map_text String = cast read_u64(scores.get(1)!)
    removed ~= {4}
    removed_text String = cast read_u64((~removed.remove(0)!))
    return [:direct_numeric_reads inline=[inline_text] map=[map_text] removed=[removed_text]]
;

text = render() catch then "failed"
[:[text]]
