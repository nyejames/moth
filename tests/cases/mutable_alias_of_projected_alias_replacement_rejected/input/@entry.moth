-- `view` is a projection-free alias of the mutable alias `writer`, whose referent is projected
-- storage in `holder`. Replacing that storage through `writer` must still see the live view.

Pair = | first {I32}, second {I32} |

same_pair |value Pair| -> Pair:
    return value
;

probe || -> I32:
    original ~= Pair({1}, {0})
    holder ~= same_pair(original)
    writer ~= holder.first
    view = writer
    ~writer = {2, 3}
    return view.length()
;

result = probe()
io.line([: [result]])
