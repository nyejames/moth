@core/time Duration, duration_from_milliseconds, duration_scale, as_milliseconds, is_negative

-- Scaling past the finite Float range produces an ordinary opaque Duration:
-- this infallible path observes the overflowed value without reading it as a
-- Float, so the rejection below cannot be coming from duration_scale itself.
survive_scale || -> Bool:
    big = duration_from_milliseconds(1.0e100)
    huge = duration_scale(big, 1.0e300)
    return is_negative(huge)
;

-- Rejection happens where the same overflowed duration is read as a Float.
read_overflow || -> Float, Error!:
    big = duration_from_milliseconds(1.0e100)
    huge = duration_scale(big, 1.0e300)
    return as_milliseconds(huge)
;

opaque = survive_scale()
overflow = read_overflow() catch |err|:
    then err.code
;

[:duration_overflow opaque=[opaque] code=[overflow]]
