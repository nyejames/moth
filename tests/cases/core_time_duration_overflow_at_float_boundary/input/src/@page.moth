@core/time Duration, duration_from_milliseconds, duration_scale, as_milliseconds

-- Scale a finite duration until the millisecond quantity leaves the finite Float range.
-- The result stays opaque here; rejection happens where it is read as a Float.
read_overflow || -> Float, Error!:
    big = duration_from_milliseconds(1.0e100)
    huge = duration_scale(big, 1.0e300)
    return as_milliseconds(huge)
;

overflow = read_overflow() catch |err|:
    then err.code
;

[:duration_overflow code=[overflow]]
