Point = |
    x I32,
    y I32,
|

load_index |items ~{I32}, idx I32| -> I32, Error!:
    return items.get(idx)!
;

point = Point(1, 2)
values ~= {point.x, point.y, 3}
~values.set(2, 8) catch:
;
selected = load_index(~values, 1) catch:
    then 0
;
io.line([: selected=[selected]])
io.line([: length=[values.length()]])
