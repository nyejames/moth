-- Task 3 under I64/F32: U64 values above i64::MAX execute through
-- the shared BigInt-carrier helpers with unsigned bounds, U64/I64
-- comparisons stay exact in both directions, and explicit U64 returns round
-- directly at F32 precision with no binary64 detour.

add_above |a U64, b U64| -> U64, Error!:
    return a + b
;

mul_above |a U64, b U64| -> U64, Error!:
    return a * b
;

sub_above |a U64, b U64| -> U64, Error!:
    return a - b
;

huge U64 = 18446744073709551615
above U64 = 9223372036854775808
max_signed I64 = 9223372036854775807
min_signed I64 = -9223372036854775808

kept_above U64 = add_above(above, 100) catch:
    then 0
;
kept_huge U64 = add_above(huge, 0) catch:
    then 0
;
huge_plus_one U64 = add_above(huge, 1) catch:
    then 7
;
zero_minus_one U64 = sub_above(0, 1) catch:
    then 9
;
exact_product U64 = mul_above(1000000000, 18446744073) catch:
    then 0
;
square_overflow U64 = mul_above(4294967296, 4294967296) catch:
    then 8
;

above_less |value U64, limit U64| -> Bool:
    return value < limit
;

signed_below |limit I64, value U64| -> Bool:
    return limit < value
;

signed_above |value U64, limit I64| -> Bool:
    return value > limit
;

above_is_less Bool = above_less(above, huge)
max_below_above Bool = signed_below(max_signed, above)
above_above_max Bool = signed_above(above, max_signed)
min_below_zero Bool = signed_below(min_signed, 0)
zero_above_min Bool = signed_above(0, min_signed)

-- Explicit U64 returns round directly at F32 precision: 9007199791611905
-- becomes bits 0x5a000001 (spelled 9007200000000000), while the forbidden
-- binary64 detour would give 0x5a000000. The explicit cast of a runtime U64
-- rounds identically.
converted_to_float |value U64| -> F32:
    return cast value
;

explicit_to_float |value U64| -> F32:
    return cast value
;

converted_witness F32 = converted_to_float(9007199791611905)
explicit_witness F32 = explicit_to_float(9007199791611905)
folded_witness #U64 = 9007199791611905
rounded_witness #F32 = cast folded_witness
comparison_float #F32 = 9007200328482816.0
folded_eq #Bool = rounded_witness is comparison_float
dynamic_eq Bool = converted_witness is comparison_float
explicit_eq Bool = explicit_witness is comparison_float

-- Dynamic U64 to I64 and I64 to U64 cast failures recover through catch.
uint_to_int |value U64| -> I64, Error!:
    return cast value
;

int_to_uint |value I64| -> U64, Error!:
    return cast value
;

huge_to_int I64 = uint_to_int(huge) catch:
    then -1
;
neg_to_uint U64 = int_to_uint(-7) catch:
    then 11
;
above_to_int I64 = uint_to_int(above) catch:
    then -2
;

-- Compound failure stores nothing and recovery keeps the entry value.
accumulate |target ~U64, delta U64| -> U64, Error!:
    ~target += delta
    return target
;

growing ~U64 = 18446744073709551611
grown U64 = accumulate(~growing, 5) catch:
    then 13
;
folded_above #U64 = 9223372036854775808
folded_above_kept U64 = folded_above + 0
dynamic_above U64 = add_above(above, 0) catch:
    then 0
;
folded_dynamic_agree Bool = folded_above_kept is dynamic_above

[:uint int64float32 wide=[kept_above]/[kept_huge]/[huge_plus_one]/[zero_minus_one] prod=[exact_product]/[square_overflow] compare=[above_is_less]/[max_below_above]/[above_above_max]/[min_below_zero]/[zero_above_min] converted=[converted_witness]/[explicit_witness]/[folded_eq]/[dynamic_eq]/[explicit_eq] casts=[huge_to_int]/[neg_to_uint]/[above_to_int] compound=[growing]/[grown] agree=[folded_dynamic_agree]]
