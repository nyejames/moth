@types TaskResult
@types format_task

-- Const payload choice
default_success #= TaskResult::Success(42, "default")

-- Function returning choice
make_result |n I32| -> TaskResult:
    if n is 0:
        return TaskResult::Pending
    ;
    if n > 2:
        return TaskResult::Failure("too big", 99)
    ;
    return TaskResult::Success(n, "num")
;

-- Function accepting choice
handle_result |r TaskResult| -> String:
    if r is:
        Success(value, label) =>
            if value > 10:
                return "big"
            ;
            return "small"
        Failure(reason, code) => return "failed"
        Pending => return "waiting"
    ;
;

-- Helper for nested match (avoids shadowing)
describe_task |t TaskResult| -> String:
    if t is:
        Success(value, label) => return "inner_ok"
        Failure(reason, code) => return "inner_fail"
        Pending => return "inner_pending"
    ;
;

small_handled = handle_result(make_result(1))
large_handled = handle_result(default_success)
failure_handled = handle_result(make_result(3))
pending_handled = handle_result(make_result(0))

-- Loop containing match with payload captures
summary ~= ""
trace ~= ""
pending_count ~= 0
success_one_count ~= 0
success_two_count ~= 0
failure_count ~= 0
i ~= 0
loop i < 4:
    current = make_result(i)
    if current is:
        Success(value, label) =>
            summary = "ok"
            trace = [:[trace]success:[value]:[label];]
            if value is:
                1 => success_one_count += 1
                2 => success_two_count += 1
                else =>
            ;
        Failure(reason, code) =>
            summary = "fail"
            trace = [:[trace]failure:[reason]:[code];]
            failure_count += 1
        Pending =>
            summary = "pending"
            trace = [:[trace]pending;]
            pending_count += 1
    ;
    i = i + 1
;

-- Nested match via helper to avoid shadowing
outer = TaskResult::Success(2, "nested")
nested_result ~= ""
if outer is:
    Success(value, label) =>
        inner = make_result(value)
        nested_result = describe_task(inner)
    Failure(reason, code) =>
        nested_result = "outer_fail"
    Pending =>
        nested_result = "outer_pending"
;

-- Use imported formatter
formatted = format_task(default_success)

-- Result interop: convert choice to result
read_task |n I32| -> TaskResult, Error!:
    if n is 0:
        return! Error("zero")
    ;
    return TaskResult::Success(n, "ok")
;

recovery_count ~= 0
recovery_error ~= ""
interop_result = read_task(5) catch |err|:
    recovery_count += 1
    recovery_error = [:[err.message]:[err.code]]
    then TaskResult::Failure("err", 0)
;

recovered_result = read_task(0) catch |err|:
    recovery_count += 1
    recovery_error = [:[err.message]:[err.code]]
    then TaskResult::Failure(err.message, 0)
;

recovered_summary ~= ""
if recovered_result is:
    Success(value, label) => recovered_summary = [:success:[value]:[label]]
    Failure(reason, code) => recovered_summary = [:failure:[reason]:[code]]
    Pending => recovered_summary = "pending"
;
-- Extract label from choice into a function to avoid borrow checker issues with captures
extract_label |t TaskResult| -> String:
    if t is:
        Success(value, label) => return label
        Failure(reason, code) => return "fail"
        Pending => return "pending"
    ;
;

interop_label = extract_label(interop_result)

[:adversarial_choice_payload_control_flow summary=[summary] nested=[nested_result] formatted=[formatted] interop=[interop_label] handles=[small_handled],[large_handled],[failure_handled],[pending_handled] trace=[trace] counts=[pending_count],[success_one_count],[success_two_count],[failure_count] recovered=[recovered_summary] error=[recovery_error] recoveries=[recovery_count]]
