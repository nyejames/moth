-- Task 4 under Int64/Float32: Uint64 boundary values execute in the Wasm lane
-- through the shared I64 carrier with unsigned opcodes, unsigned rendering and
-- exact Uint/Int comparisons. Literal arithmetic folds before the backend;
-- dynamic comparisons, conversions and formatting exercise the supported scalar paths.

compare_below |limit Int, edge Uint| -> String:
    return if limit < edge then "yes" else "no"
;

compare_above |edge Uint, limit Int| -> String:
    return if edge > limit then "yes" else "no"
;

compare_equal |edge Uint, other Uint| -> String:
    return if edge is other then "yes" else "no"
;

compare_uint_below |lower Uint, upper Uint| -> String:
    return if lower < upper then "yes" else "no"
;

above Uint = 9223372036854775808 + 0
kept_above Uint = 9223372036854775808 + 100
huge Uint = 18446744073709551615 + 0
exact_product Uint = 1000000000 * 18446744073
max_signed Int = 9223372036854775807
min_signed Int = -9223372036854775808

above_less_text String = compare_below(max_signed, above)
above_equal_text String = compare_equal(huge, 18446744073709551615)
signed_orders_text String = compare_uint_below(9223372036854775807, above)
above_above_max_text String = compare_above(above, max_signed)
min_below_zero_text String = compare_below(min_signed, 0)
zero_above_min_text String = compare_above(0, min_signed)

-- Uint converts directly to the profile Float with no signed intermediate. The
-- Float32 witness rounds 9007199791611905 to bits 0x5a000001 (9007200000000000);
-- the forbidden binary64 detour would give 0x5a000000 instead.
implicit_to_float |value Uint| -> Float:
    return value
;

explicit_to_float |value Uint| -> Float:
    return cast value
;

implicit_witness Float = implicit_to_float(9007199791611905)
explicit_witness Float = explicit_to_float(above)
fmt_above String = cast above
fmt_huge String = cast huge

[:uint wasm64 wide=[kept_above]/[huge] prod=[exact_product] compare=[above_less_text]/[above_equal_text]/[signed_orders_text]/[above_above_max_text]/[min_below_zero_text]/[zero_above_min_text] float=[implicit_witness]/[explicit_witness] fmt=[fmt_above]/[fmt_huge]]
