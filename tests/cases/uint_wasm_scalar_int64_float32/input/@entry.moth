-- Task 4 with exact I64/F32: U64 boundary values execute in the Wasm lane
-- through the shared I64 carrier with unsigned opcodes, unsigned rendering and
-- exact U64/I64 comparisons. Literal arithmetic folds before the backend;
-- dynamic comparisons, conversions and formatting exercise the supported scalar paths.

compare_below |limit I64, edge U64| -> String:
    return if limit < edge then "yes" else "no"
;

compare_above |edge U64, limit I64| -> String:
    return if edge > limit then "yes" else "no"
;

compare_equal |edge U64, other U64| -> String:
    return if edge is other then "yes" else "no"
;

compare_uint_below |lower U64, upper U64| -> String:
    return if lower < upper then "yes" else "no"
;

above U64 = 9223372036854775808 + 0
kept_above U64 = 9223372036854775808 + 100
huge U64 = 18446744073709551615 + 0
exact_product U64 = 1000000000 * 18446744073
max_signed I64 = 9223372036854775807
min_signed I64 = -9223372036854775808

above_less_text String = compare_below(max_signed, above)
above_equal_text String = compare_equal(huge, 18446744073709551615)
signed_orders_text String = compare_uint_below(9223372036854775807, above)
above_above_max_text String = compare_above(above, max_signed)
min_below_zero_text String = compare_below(min_signed, 0)
zero_above_min_text String = compare_above(0, min_signed)

-- U64 converts directly to exact F32 with no signed intermediate. The
-- F32 witness rounds 9007199791611905 to bits 0x5a000001 (9007200000000000);
-- the forbidden binary64 detour would give 0x5a000000 instead.
converted_to_float |value U64| -> F32:
    return cast value
;

explicit_to_float |value U64| -> F32:
    return cast value
;

converted_witness F32 = converted_to_float(9007199791611905)
explicit_witness F32 = explicit_to_float(above)
fmt_above String = cast above
fmt_huge String = cast huge

[:uint wasm64 wide=[kept_above]/[huge] prod=[exact_product] compare=[above_less_text]/[above_equal_text]/[signed_orders_text]/[above_above_max_text]/[min_below_zero_text]/[zero_above_min_text] float=[converted_witness]/[explicit_witness] fmt=[fmt_above]/[fmt_huge]]
