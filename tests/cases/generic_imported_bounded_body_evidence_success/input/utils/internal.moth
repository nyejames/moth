DISPLAY_TEXT must:
    display |This| -> String
;

Label = |
    text String,
|

display |this Label| -> String:
    return this.text
;

Label must DISPLAY_TEXT

identity type T is DISPLAY_TEXT |value T| -> String:
    return value.display()
;

wrap type T is DISPLAY_TEXT |value T| -> String:
    return identity(value)
;

Box type T = |
    value T,
|

render type T is DISPLAY_TEXT |this Box of T| -> String:
    return identity(this.value)
;
