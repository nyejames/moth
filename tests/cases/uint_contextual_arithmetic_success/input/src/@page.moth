-- Task 2A: U32 contextual arithmetic. U32 receivers and both-sided U32
-- peers type unresolved whole-number arithmetic as U32; decimal leaves keep
-- F64 typing and select the mixed U32/F64 rule.

peer_left_text |value U32| -> String:
    result = value + (1 + 2)
    return [result]
;

peer_right_text |value U32| -> String:
    result = (1 + 2) + value
    return [result]
;

peer_group_right_text |value U32| -> String:
    result = value + ((1 + 2) * 2)
    return [result]
;

peer_product_text |value U32| -> String:
    result = value + (1 * 2)
    return [result]
;

peer_typed_inner_text |value U32, other U32| -> String:
    result = value + (other + 1)
    return [result]
;

received_typed_inner_text |value U32, other U32| -> String:
    result U32 = value + (other + 1)
    return [result]
;

typed_inner_text |left U32, right U32| -> String:
    result U32 = (left + right) + 1
    return [result]
;

received_inner_text |left U32, right U32| -> String:
    result U32 = left + (right + 1)
    return [result]
;

same_text |value U32| -> String:
    result Bool = value is (1 + 2)
    return [result]
;

ordered_text |value U32| -> String:
    result Bool = value < (1 + 20)
    return [result]
;

power_uint_exponent_text |exponent U32| -> String:
    result U32 = 2 ^ exponent
    return [result]
;

take_uint |value U32| -> U32:
    return value
;

explicit_return_text || -> U32:
    return 1 + 2
;

with_default |value U32 = 1 + 2| -> U32:
    return value
;

branch_text |flag Bool| -> U32:
    result U32 = if flag:
        then 1 + 2
    else
        then 3 + 4
    ;
    return result
;

split_pair |flag Bool| -> U32, I32:
    return 1 + 2, 3 + 4
;

make_uint || -> U32:
    return 1 + 2
;

call_peer_text || -> String:
    result = make_uint() + (1 + 2)
    return [result]
;

mutable_assign_text || -> String:
    target ~U32 = 0
    target = 1 + 2
    return [target]
;

render_uint_text |value U32| -> String:
    return [value]
;

Point = |
    x U32,
|

count U32 = 1 + 2
large U32 = 3_000_000_000 + 1
cast_operand_result U32 = cast (1 + 2) catch then 0
assert(cast_operand_result is 3)
grouped U32 = (1 + 2) * 3
peer U32 = 10
from_right = (1 + 2) + peer
from_left = peer + (1 + 2)
power_group U32 = 2 ^ (1 + 2)
power_right U32 = 2 ^ 3 ^ 2
power_left U32 = (2 ^ 3) ^ 2
int_div U32 = 7 // 2
remainder U32 = 7 % 3
floating_peer F64 = cast peer
mixed_left = 1.5 + floating_peer
mixed_right = floating_peer + 1.5
real_div = peer / 4
accumulate ~U32 = 10
accumulate += 1 + 2
scaled ~U32 = 10
scaled *= 1 + 2
powered ~U32 = 2
powered ^= 1 + 2
peer_left = peer_left_text(10)
peer_right = peer_right_text(10)
peer_group_right = peer_group_right_text(10)
peer_product = peer_product_text(10)
peer_typed_inner = peer_typed_inner_text(10, 3)
received_typed_inner = received_typed_inner_text(10, 3)
typed_inner = typed_inner_text(3, 4)
received_inner = received_inner_text(3, 4)
comparison = same_text(3)
ordered = ordered_text(3)
power_typed = power_uint_exponent_text(3)
concrete_argument = take_uint(1 + 2)
explicit_return = explicit_return_text()
omitted_default = with_default()
branch_true = branch_text(true)
branch_false = branch_text(false)
split_first U32, split_second I32 = split_pair(true)
mutable_assign = mutable_assign_text()
optional_payload U32? = 1 + 2
optional_text String = if optional_payload is |payload| then [payload] else "none"
point Point = Point(x = 1 + 2)
elements {U32} = {1 + 2}
element_value U32 = elements.get(0) catch:
    then 0
;
keyed {String = U32} = { "a" = 1 + 2 }
keyed_value U32 = keyed.get("a") catch:
    then 0
;
missing U32 = elements.get(5) catch then 4 + 5
call_peer = call_peer_text()
amount Dec2 = 1.5
dec_uint_power Dec2 = amount + (3 ^ 2)
decmix Dec2 = 1.5 + peer
float_from_uint F64 = cast peer
rendered = render_uint_text(peer)
matched_text ~= ""
m U32 = 5
if m is:
    5 => matched_text = "five"
    else => matched_text = "other"
;

[:uint context count=[count] large=[large] grouped=[grouped] right=[from_right] left=[from_left] power-group=[power_group] power-right=[power_right] power-left=[power_left] intdiv=[int_div] rem=[remainder] mixed-left=[mixed_left] mixed-right=[mixed_right] div=[real_div] acc=[accumulate] scaled=[scaled] powered=[powered] peer-left=[peer_left] peer-right=[peer_right] peer-group-right=[peer_group_right] peer-product=[peer_product] peer-typed-inner=[peer_typed_inner] received-typed-inner=[received_typed_inner] typed-inner=[typed_inner] received-inner=[received_inner] same=[comparison] ordered=[ordered] power-typed=[power_typed] concrete=[concrete_argument] explicit=[explicit_return] default=[omitted_default] branch=[branch_true]/[branch_false] split=[split_first]/[split_second] mutable=[mutable_assign] optional=[optional_text] point=[point.x] element=[element_value] keyed=[keyed_value] missing=[missing] call-peer=[call_peer] dec-power=[dec_uint_power] decmix=[decmix] float=[float_from_uint] rendered=[rendered] match=[matched_text]]
