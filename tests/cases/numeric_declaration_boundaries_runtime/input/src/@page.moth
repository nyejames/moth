default_count #= 7
capacity #= 2

Holder = |value U64 = 18_446_744_073_709_551_615|

read_default |value I32| -> String:
    return cast value
;
read_fixed |values {capacity U64}| -> String:
    first = values.get(0) catch then 0
    return [:value=[first] length=[values.length()]]
;

holder = Holder()
values {capacity U64} = {18_446_744_073_709_551_615}
[:numeric_boundaries default=[read_default(default_count)] field=[holder.value] fixed=[read_fixed(values)]]
