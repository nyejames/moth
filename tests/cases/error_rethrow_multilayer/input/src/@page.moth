-- Error rethrow through multiple layers.

inner || -> String, I32, Error!:
    return! Error("origin")
;

middle || -> String, I32, Error!:
    v, n = inner()!
    return v, n
;

outer || -> String, I32, Error!:
    value, numeric_value = middle() catch |err|:
        return! err
    ;
    return value, numeric_value
;

result, count = outer() catch:

    then "outer_handler", 0

;
io.line([: [result]])
io.line([: [count]])
