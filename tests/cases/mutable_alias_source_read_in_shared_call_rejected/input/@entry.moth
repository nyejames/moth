-- Passing the source alias to a shared call is still a read through it while the child alias is
-- live.

show |items {I32}| -> I32:
    return items.length()
;

probe || -> I32:
    slot ~= {1}
    parent ~= slot
    child ~= parent
    n = show(parent)
    ~child.push(2)
    return n
;

result = probe()
io.line([: [result]])
