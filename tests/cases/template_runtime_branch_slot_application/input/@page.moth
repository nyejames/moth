card = [:
    <section>
        <h1>[$slot("title")]</h1>
        <div>[$slot]</div>
        <aside>[$slot("aside")]</aside>
    </section>
]

show_title = false
maybe_title String? = "Priya"
body = "runtime body"

rendered = [card:
    [$insert("title"):
        [if maybe_title is |title|:
            Hello [title]
        ]
    ]

    [if not show_title:
        Body [body]
    ]
]

io.line(rendered)
