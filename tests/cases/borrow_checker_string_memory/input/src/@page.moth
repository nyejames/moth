-- String and template values flow through shared aliases without copying and
-- without blocking a later mutable rebinding of a separate template buffer.
-- Every alias and the rebound buffer is named in one top-level output event.

message = "Hello, world!"

greeting = message
ref1 = message
ref2 = message

buffer ~= [:initial content]
buffer = [:updated content]

[:borrow_checker_string_memory greeting=[greeting] ref1=[ref1] ref2=[ref2] buffer=[buffer]]
