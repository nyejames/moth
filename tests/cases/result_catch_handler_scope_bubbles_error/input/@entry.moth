can_error |name String| -> String, I32, Error!:
    return! Error("boom")
;

rethrow |name String| -> String, I32, Error!:
    value, numeric_value = can_error(name) catch |err|:
        return! err
    ;
    return value, numeric_value
;

first, count = rethrow("Ana") catch:

    then "fallback", 0

;
io.line([:bubbled-recovery-first=[first]])
io.line([:bubbled-recovery-count=[count]])
