@external_uint.js identity_uint

-- U32 rides an exact Number across the foreign boundary: zero, the
-- unsigned maximum and the signed-max-plus-one value that separates the
-- U32 range from I32 all survive the round trip unchanged.
zero U32 = identity_uint(0)
small U32 = identity_uint(17)
signed_max_plus_one U32 = identity_uint(2147483648)
top U32 = identity_uint(4294967295)
io.line([: external_native_uint32 zero=[zero] small=[small] above_signed=[signed_max_plus_one] max=[top]])
