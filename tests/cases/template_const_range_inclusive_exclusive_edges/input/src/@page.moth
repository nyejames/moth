fixed_u8_start #U8 = 1
fixed_u8_end #U16 = 3
fixed_u8_step #U8 = 1
fixed_u8_equal #U8 = 2
fixed_f16_start #F16 = 0.5
fixed_f16_end #F16 = 1.5
fixed_f16_step #F16 = 0.5
fixed_f16_equal #F16 = 1.0
profile_i64_start #I64 = 1
profile_i64_end #I64 = 3
profile_f32_equal #F32 = 2.0
profile_f32_step #F32 = 0.0000000000000001

#[loop profile_i64_start to profile_i64_end |i|:
    excl-[i];
]

#[loop profile_i64_start to & profile_i64_end |i|:
    incl-[i];
]

#[loop profile_f32_equal to profile_f32_equal by profile_f32_step |i|:
    float-exclusive-equal-[i];
]

#[loop profile_f32_equal to & profile_f32_equal by profile_f32_step |i|:
    float-inclusive-equal-[i];
]

#[loop fixed_u8_start to & fixed_u8_end by fixed_u8_step |i|:
    fixed-u8-u16-promoted-[i];
]

#[loop fixed_u8_equal to fixed_u8_equal by fixed_u8_step |i|:
    fixed-u8-exclusive-equal-[i];
]

#[loop fixed_u8_equal to & fixed_u8_equal by fixed_u8_step |i|:
    fixed-u8-inclusive-equal-[i];
]

#[loop fixed_f16_start to & fixed_f16_end by fixed_f16_step |i|:
    fixed-f16-range-[i];
]

#[loop fixed_f16_equal to fixed_f16_equal by fixed_f16_step |i|:
    fixed-f16-exclusive-equal-[i];
]

#[loop fixed_f16_equal to & fixed_f16_equal by fixed_f16_step |i|:
    fixed-f16-inclusive-equal-[i];
]
