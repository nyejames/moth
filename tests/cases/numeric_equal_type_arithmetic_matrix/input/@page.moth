-- Concrete operands and exact receivers prove both folded and runtime domains.

check_i8_i8 |left I8, right I8| -> String:
    add I8 = left + right
    subtract I8 = left - right
    multiply I8 = left * right
    divide F64 = left / right
    integer_divide I8 = left // right
    remainder I8 = left % right
    power I8 = left ^ right
    return [:[add]/[subtract]/[multiply]/[divide]/[integer_divide]/[remainder]/[power]]
;

i8_i8_left #I8 = 2
i8_i8_right #I8 = 2
i8_i8_add #I8 = i8_i8_left + i8_i8_right
i8_i8_subtract #I8 = i8_i8_left - i8_i8_right
i8_i8_multiply #I8 = i8_i8_left * i8_i8_right
i8_i8_divide #F64 = i8_i8_left / i8_i8_right
i8_i8_integer_divide #I8 = i8_i8_left // i8_i8_right
i8_i8_remainder #I8 = i8_i8_left % i8_i8_right
i8_i8_power #I8 = i8_i8_left ^ i8_i8_right
i8_i8_folded #= [:[i8_i8_add]/[i8_i8_subtract]/[i8_i8_multiply]/[i8_i8_divide]/[i8_i8_integer_divide]/[i8_i8_remainder]/[i8_i8_power]]
i8_i8_runtime = check_i8_i8(2, 2)
i8_i8_matches = i8_i8_runtime is i8_i8_folded

