-- Test file: Proper mutation syntax (should succeed)

-- Declare mutable variables first
counter ~= 0
value ~= 10
message ~= [:Start]
flag ~= false

-- Proper mutations using = operator
~counter = counter + 1
~value = value * 2
~message = [:updated]
~flag = true

-- More complex mutations
~counter = counter - 5
~value = value // 4

Amount as I32

update_amount |amount ~Amount|:
    ~amount = amount + 1
;

unchanged Amount = 7
update_amount(~value)

[: counter=[counter];value=[value];message=[message];flag=[flag];unchanged=[unchanged]]
