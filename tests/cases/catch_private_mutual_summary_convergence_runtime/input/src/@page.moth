-- The handler is authored before either private summary is complete. Failure
-- must cross the mutual recursion before reaching this continuation.
recover |text String| -> String:
    code ~U32 = 0
    value = first(text, true) catch |parse_error|:
        code = parse_error.code
        then -7
    ;
    return [:[value]/[code]]
;

first |text String, again Bool| -> I32:
    if again:
        return second(text, false)
    ;
    return cast text
;

second |text String, again Bool| -> I32:
    return first(text, again)
;

export:
    DomainError :: Invalid;

    builtin_forward |text String| -> I32, Error!:
        return first(text, true)
    ;

    custom_map |text String| -> I32, DomainError!:
        value = first(text, true) catch |mapped_error|:
            assert(mapped_error.code is 200)
            return! DomainError::Invalid
        ;
        return value
    ;
;

builtin_code ~U32 = 0
builtin_value = builtin_forward("bad") catch |builtin_error|:
    builtin_code = builtin_error.code
    then -8
;
custom_value = custom_map("bad") catch |domain_error|:
    assert(domain_error is DomainError::Invalid)
    then -9
;
custom_success = custom_map("43") catch then -10
[:private=[recover("bad")]/[recover("42")] builtin=[builtin_value]/[builtin_code] custom=[custom_value]/[custom_success]]
