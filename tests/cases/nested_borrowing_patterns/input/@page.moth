-- Aliasing an alias keeps reading the original value at every depth, and once
-- the last shared read of a mutable binding has happened the binding can be
-- rebound. Each depth and the rebound value is named in one output event.

render_nested_borrowing || -> String:
    original_data = "hello world"

    first_ref = original_data
    second_ref = first_ref
    third_ref = second_ref

    mutable_data ~= 42

    shared_ref = mutable_data
    nested_shared1 = shared_ref
    nested_shared2 = nested_shared1

    sum = shared_ref + nested_shared1 + nested_shared2

    mutable_data = mutable_data + 10

    return [:nested_borrowing_patterns first=[first_ref] second=[second_ref] third=[third_ref] sum=[sum] rebound=[mutable_data]]
;

[:[render_nested_borrowing()]]
