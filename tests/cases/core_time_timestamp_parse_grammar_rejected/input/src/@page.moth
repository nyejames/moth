@core/time Timestamp, timestamp_from_iso_string

parse || -> Int, Error!:
    ts = timestamp_from_iso_string("1970-01-01T00:00:00")!
    return 0
;

-- Missing designator is rejected
code ~U32 = 0
ignored = parse() catch |err|:
    code = err.code
    then 0
;

[: timestamp_parse_grammar_missing_designator code=[code]]