identity |value String| -> String:
    return value
;

card #= [:title=[$slot title = "Title fallback"]|pos=[$slot 1 = "Positional fallback"]|body=[$slot = "Body fallback"]]
box #= [:title=[$slot title = "Title fallback"]|body=[$slot = "Body fallback"]]

-- The newlines and indentation around each insert are body formatting, not a
-- loose contribution. They must not consume the positional occurrence or mark
-- the default occurrence routed, and they must not suppress the named default.
named = [card:
    [$in title:Chosen]
]
default_fallback = [box:
    [$in title:Chosen]
]
paired = [card:
    [$in title:First]
    [$in title:Second]
]
box_paired = [box:
    [$in title:First]
    [$in title:Second]
]
runtime = [card:
    [$in title:[identity("Runtime")]]
]
emptied = [card:
    [$in title:]
]
head_whitespace = [box, " ":[$in title:Space]]
head_empty = [box, "":[$in title:Empty]]
padded_before = [box: [$in title:Chosen] Body]
padded_after = [box:[$in title:Chosen] Body]
authored_before = [box: Body [$in title:Chosen]]
padded_trailing = [box: Body [$in title:Chosen] ]
tight_trailing = [box:Body[$in title:Chosen] ]

~[:named=[named]|default=[default_fallback]|paired=[paired]|box_paired=[box_paired]|runtime=[runtime]|emptied=[emptied]|space=[head_whitespace]|empty=[head_empty]|padded_before=[padded_before]|padded_after=[padded_after]|authored_before=[authored_before]|padded_trailing=[padded_trailing]|tight_trailing=[tight_trailing]]
