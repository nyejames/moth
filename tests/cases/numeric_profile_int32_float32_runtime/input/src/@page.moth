format_float |value Float| -> String:
    return cast value
;

compare |integer Int, float_value Float| -> Bool:
    return integer is float_value
;

add |left Float, right Float| -> Float, Error!:
    return left + right
;

int_to_float |value Int| -> Float:
    return cast value
;

float_to_int |value Float| -> Int, Error!:
    return cast! value
;

increment |value Int| -> Int, Error!:
    return value + 1
;

same_folded #Bool = 16777217 is 16777216.0
same_runtime = compare(16777217, 16777216.0)

rounded_float_text = format_float(int_to_float(16777217))
sum_value = add(0.1, 0.2) catch:
    then 0.0
;
sum_text = format_float(sum_value)
rounded_value = add(42.75, 0.75) catch:
    then 0.0
;
float_to_int_value = float_to_int(rounded_value) catch:
    then -1
;
range_error_code = increment(2147483647) catch |overflow_error|:
    then overflow_error.code
;

tie_one #Float = 17.0078125
tie_two #Float = 241.640625
tie_three #Float = 234.453125
tie_one_folded #String = cast tie_one
tie_two_folded #String = cast tie_two
tie_three_folded #String = cast tie_three

tie_one_runtime = format_float(tie_one)
tie_two_runtime = format_float(tie_two)
tie_three_runtime = format_float(tie_three)

non_tie_one #Float = 0.1
non_tie_two #Float = 3.25
non_tie_one_folded #String = cast non_tie_one
non_tie_two_folded #String = cast non_tie_two
non_tie_one_runtime = format_float(non_tie_one)
non_tie_two_runtime = format_float(non_tie_two)

[:int32-float32 same=[same_folded]/[same_runtime] int-to-float=[rounded_float_text] sum=[sum_text] float-to-int=[float_to_int_value] range-error=[range_error_code] ties=[tie_one_folded]|[tie_one_runtime],[tie_two_folded]|[tie_two_runtime],[tie_three_folded]|[tie_three_runtime] non-ties=[non_tie_one_folded]|[non_tie_one_runtime],[non_tie_two_folded]|[non_tie_two_runtime]]
