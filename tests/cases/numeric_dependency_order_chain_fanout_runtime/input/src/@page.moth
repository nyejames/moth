render_u64 |value U64| -> String:
    return cast value
;

before || -> String:
    origin = 4_294_967_296
    selected U64 = origin
    next_value = origin + origin
    return [:[render_u64(selected)]/[render_u64(next_value)]]
;

after || -> String:
    origin = 4_294_967_296
    next_value = origin + origin
    selected U64 = origin
    return [:[render_u64(selected)]/[render_u64(next_value)]]
;

