-- `$fast_math` never creates a fast Dec path. The total add and negation sit in the same
-- block as the dividing operation that really fails; the success call observes both values,
-- and the failing call must still recover through ordinary Dec semantics.
$fast_math
adjust_dec |dividend Dec2, divisor Dec2| -> Dec2, Error!:
    shifted = dividend + 0
    negated = -shifted
    return negated / divisor
;

$fast_math
power_dec |base Dec1, exponent I32| -> Dec1, Error!:
    return base ^ exponent
;

one Dec2 = 1
zero Dec2 = 0
recovered Dec2 = adjust_dec(one, zero) catch:
    then 7
;
observed Dec2 = adjust_dec(3, 2) catch:
    then 0
;
power_code ~U32 = 0
recovered_power = power_dec(1, -1) catch |power_error|:
    ~power_code = power_error.code
    then 9
;
io.line([:recovered=[recovered] observed=[observed] power=[recovered_power]/[power_code]])
