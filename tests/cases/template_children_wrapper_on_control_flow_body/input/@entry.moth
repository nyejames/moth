[:template_children_wrapper_on_control_flow_body
    [:if:]
    [$before = [:<b>], $after = [:</b>], if true:
        [:A]
        [:B]
    ]
    [:loop:]
    [$before = [:<i>], $after = [:</i>], loop 0 to 2 |n|:
        [n]
    ]
    [:fresh:]
    [$before = [:<u>], $after = [:</u>], if true:
        [$fresh: [:Y]]
    ]
    [:skip:]
    [$before = [:<s>], $after = [:</s>], if true:
        [if false: Z]
    ]
]
