overflow_int || -> Int, Error!:
    x = 2147483647
    return x + 1
;

nonfinite_float || -> Float, Error!:
    x = 1e200
    return x * 1e200
;

int_code ~U32 = 0
overflow_value = overflow_int() catch |int_err|:
    int_code = int_err.code
    then 0
;

float_code ~U32 = 0
nonfinite_value = nonfinite_float() catch |float_err|:
    float_code = float_err.code
    then 0.0
;

[: numeric recovery codes=[int_code]/[float_code]]
