$export
LEFT_TEXT must:
    left_text |This| -> String
;
$export
RIGHT_TEXT must:
    right_text |This| -> String
;
$export
FIRST_TEXT must:
    first_text |This| -> String
;
$export
SECOND_TEXT must:
    second_text |This| -> String
;

$export
combine type T is FIRST_TEXT and SECOND_TEXT |value T| -> String:
    return [:[value.first_text()]/[value.second_text()]]
;
