profile_edges |add_value I64, subtract_value I64, multiply_left I64, multiply_right I64, negate_value I64| -> String:
    incremented = add_value + 1
    decremented = subtract_value - 1
    product = multiply_left * multiply_right
    negated = -negate_value
    assert(incremented is 9223372036854775807)
    assert(decremented is -9223372036854775808)
    assert(product is 9223372030926249001)
    assert(negated is 9223372036854775807)
    return "int64-profile-edges-ok"
;

profile_int_to_i64 |value I64| -> String:
    widened I64 = value
    assert(widened is 9223372036854775807)
    return "int64-profile-cast-ok"
;

edges = profile_edges(9223372036854775806, -9223372036854775807, 3037000499, 3037000499, -9223372036854775807)
cast_result = profile_int_to_i64(9223372036854775807)
[:integer checked arithmetic profile=[edges]/[cast_result]]
