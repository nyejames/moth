-- Task 2B: runtime U32/F32 comparisons convert U32 directly to the
-- declared F32, so they agree with folding. Under F32, 16777217
-- rounds to 16777216.0, which discriminates a raw-carrier comparison.

runtime_eq |a U32, b F32| -> Bool:
    converted F32 = cast a
    return converted is b
;

runtime_lt |b F32, a U32| -> Bool:
    converted F32 = cast a
    return b < converted
;

big #U32 = 16777217
rounded_big #F32 = cast big
comparison_float #F32 = 16777216.0
folded_eq #Bool = rounded_big is comparison_float
folded_lt #Bool = comparison_float < rounded_big
big_value U32 = 16777217
cmp_runtime_eq Bool = runtime_eq(big_value, comparison_float)
cmp_runtime_lt Bool = runtime_lt(comparison_float, big_value)

[:uint float32 eq=[folded_eq]/[cmp_runtime_eq] lt=[folded_lt]/[cmp_runtime_lt]]
