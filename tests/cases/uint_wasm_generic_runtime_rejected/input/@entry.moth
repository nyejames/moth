-- Task 4: a U32 carried through a generic aggregate executes in HTML-JS,
-- while HTML-Wasm rejects the reachable fixed-width aggregate with a
-- structured diagnostic before lowering.

Box type T = |
    value T,
|

top U32 = 4294967295 + 0
boxed = Box(top)
top_text String = cast boxed.value

[:uint aggregate box=[boxed.value]/[top_text]]
