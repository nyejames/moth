-- A join keeps every alternative a value may observe. One path replaces the holder with a
-- freshly built value and snapshots it, so `snap` may alias the holder after the join. Taking
-- a mutable projection of the holder while `snap` is still read later conflicts with it.

Pair = | first {I32}, second {I32} |

identity |value Pair| -> Pair:
    return value
;

probe |flag Bool| -> I32:
    original ~= Pair({4}, {0})
    holder ~= identity(original)
    snap ~= Pair({9}, {0})
    if flag:
        ~holder = Pair({1}, {0})
        ~snap = identity(holder)
    ;
    writer ~= holder.first
    view = snap.first
    ~writer = {2, 3, 4}
    return view.length()
;

result = probe(flag = true)
io.line([: [result]])
