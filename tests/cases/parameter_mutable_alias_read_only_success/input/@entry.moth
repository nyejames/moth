-- Reading through a mutable alias does not write to its source parameter. Creating
-- an independent copy also leaves the original parameter unwritten.

read_through_alias |divisor ~I32| -> I32:
    n ~I32 = divisor
    return n
;

read_copy |source I32| -> I32:
    snapshot ~I32 = copy source
    return snapshot
;

first = read_through_alias(3)
second = read_copy(4)
io.line([:parameter_mutable_alias_read_only_success first=[first] second=[second]])
