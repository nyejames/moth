capacity #Int = 4
Names as {capacity String}

render_alias || -> String:
    names ~Names = {"a"}
    ~names.push("b") catch:
    ;
    first = names.get(1) catch:
        then ""
    ;
    len = names.length()
    return [:fixed_collection_alias_success first=[first] length=[len]]
;

[:[render_alias()]]
