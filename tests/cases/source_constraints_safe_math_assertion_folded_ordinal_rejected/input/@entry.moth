-- The authored body reaches the loop's step block, so the generated ordinal update is selected
-- source. The folded assertion lowers as a runtime check inside the body, so both profiles must
-- reject the fast ordinal under `$safe_math`.
always_false || -> Bool:
    return false
;

$fast_math $safe_math
asserted_ordinal |limit I32| -> I32:
    loop 0 to limit |value, index|:
        assert(always_false())
    ;
    return 0
;

~[:done]
