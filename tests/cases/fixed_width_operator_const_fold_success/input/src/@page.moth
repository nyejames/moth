small #U8 = 200
sum #= small + 100
sum_text #String = cast sum

signed_min #I8 = -128
mixed #= signed_min + small
mixed_text #String = cast mixed

seven #U8 = 7
half #= seven / 2
half_text #String = cast half

negative #I32 = -7
truncated #= negative // 2
truncated_text #String = cast truncated
remainder #= negative % 2
remainder_text #String = cast remainder

minus_one #I64 = -1
largest #U64 = 18446744073709551615
ordered #= minus_one < largest

half_precision #F16 = 0.5
quarter #F32 = 0.25
float_sum #= half_precision + quarter
float_sum_text #String = cast float_sum

flipped #= -signed_min
flipped_text #String = cast flipped

raw #Byte = 200
raw_ordered #= raw > 100

[: folded: [sum_text] [mixed_text] [half_text] [truncated_text] [remainder_text] [ordered] [float_sum_text] [flipped_text] [raw_ordered]]
