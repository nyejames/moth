-- Only one branch derives the joined value through the exclusive alias. Derivation is a must
-- fact, so the other branch loses the exemption and the read conflicts with the live alias.

identity |value {I32}| -> {I32}:
    return value
;

show |items {I32}| -> I32:
    return items.length()
;

probe |flag Bool| -> I32:
    slot ~= {1}
    writer ~= slot
    other ~= {2}
    value = if flag then identity(writer) else other
    first = show(value)
    ~writer.push(2)
    return first
;

result = probe(flag = true)
io.line([: [result]])
