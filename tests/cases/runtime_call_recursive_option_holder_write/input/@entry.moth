Link = |items {I32}|

pick |again Bool, holder ~Link| -> Link?:
    if again:
        if pick(false, ~holder) is none:
            return holder
        ;
    ;
    return none
;

through |holder ~Link, next {I32}, flag Bool| -> Link?:
    writer ~= pick(flag, ~holder)?
    ~writer.items = next
    return writer
;

run |flag Bool| -> I32:
    holder ~= Link({0})
    if through(~holder, {2, 3}, flag) is |value|:
        return value.items.length()
    ;
    return holder.items.length()
;

~[:[run(true)] / [run(false)]]
