@core/time Timestamp, timestamp_from_iso_string

parse || -> Int, Error!:
    ts = timestamp_from_iso_string("2024-02-30T00:00:00Z")!
    return 0
;

-- An invalid calendar day is rejected instead of rolling over
code = parse() catch |err|:
    then err.code
;

[: timestamp_parse_calendar_invalid_day code=[code]]