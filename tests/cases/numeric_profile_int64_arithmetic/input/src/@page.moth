format_int |value Int| -> String:
    return cast value
;

increment |value Int| -> Int, Error!:
    return value + 1
;

negate |value Int| -> Int, Error!:
    return -value
;

multiply |left Int, right Int| -> Int, Error!:
    return left * right
;

divide |dividend Int, divisor Int| -> Int, Error!:
    return dividend // divisor
;

remainder |dividend Int, divisor Int| -> Int, Error!:
    return dividend % divisor
;

power |base Int, exponent Int| -> Int, Error!:
    return base ^ exponent
;

parse_int |text String| -> Int, Error!:
    return cast text
;

float_to_int |value Float| -> Int, Error!:
    return cast value
;

assign_divide |target ~Int| -> Int, Error!:
    target /= 1
    return target
;

assign_integer_divide |target ~Int| -> Int, Error!:
    target //= 1
    return target
;

int_to_float |value Int| -> Float:
    return cast value
;

max_text = format_int(9223372036854775807)
min_text = format_int(-9223372036854775808)
product_value = multiply(9007199254740993, 3) catch:
    then 0
;
product_text = format_int(product_value)
quotient_value = divide(-9223372036854775807, 3) catch:
    then 0
;
quotient_text = format_int(quotient_value)
remainder_value = remainder(-9223372036854775807, 3) catch:
    then 0
;
remainder_text = format_int(remainder_value)
power_value = power(2, 62) catch:
    then 0
;
power_text = format_int(power_value)
add_overflow = increment(9223372036854775807) catch:
    then -11
;
negate_overflow = negate(-9223372036854775808) catch:
    then -12
;
divide_overflow = divide(-9223372036854775808, -1) catch:
    then -13
;
power_overflow = power(2, 63) catch:
    then -14
;
invalid_exponent = power(2, -1) catch:
    then -15
;
parsed_max = parse_int("9223372036854775807") catch:
    then -97
;
parsed_max_text = format_int(parsed_max)
parse_overflow = parse_int("9223372036854775808") catch:
    then -98
;
float_truncate = float_to_int(42.75) catch:
    then -100
;
float_overflow = float_to_int(9.223372e18) catch:
    then -101
;

divide_target ~= 9007199254740993
integer_divide_target ~= 9007199254740993
divide_result = assign_divide(~divide_target) catch:
    then -102
;
integer_divide_result = assign_integer_divide(~integer_divide_target) catch:
    then -103
;
divide_result_text = format_int(divide_result)
integer_divide_result_text = format_int(integer_divide_result)
rounded_profile_float = int_to_float(9007199254740993)
rounded_profile_float_text String = cast rounded_profile_float

[: int64 max=[max_text] min=[min_text] product=[product_text] quotient=[quotient_text] remainder=[remainder_text] power=[power_text] add-overflow=[add_overflow] negate-min=[negate_overflow] divide-min=[divide_overflow] power-overflow=[power_overflow] invalid-exponent=[invalid_exponent] parse-max=[parsed_max_text] parse-overflow=[parse_overflow] float-truncate=[float_truncate] float-overflow=[float_overflow] profile-divide=[divide_result_text]/[integer_divide_result_text] int-to-float=[rounded_profile_float_text]]
