$export
KIND_SOURCE must:
    kind |This| -> Kind
;

$export
KIND_LABEL must:
    label |This| -> String
;

$export
Kind ::
    Small,
    Large,
;

$export
Maker = |
    label String,
|

$export
make_maker || -> Maker:
    return Maker(label = "maker")
;

$export
show type T is KIND_LABEL |value T| -> String:
    return value.label()
;

label |this Kind| -> String:
    return "choice nominal"
;

kind |this Maker| -> Kind:
    return Kind::Large
;

Kind must KIND_LABEL
Maker must KIND_SOURCE
