@theme accent

private_prefix #= "facade"

PrivateLabel = |
    text String,
|

make_private_label |text String| -> PrivateLabel:
    return PrivateLabel([: [private_prefix]-[text]-[accent]])
;

$export
UnusedBox type T = |
    value T,
|

$export
UnusedChoice type T ::
    Some | value T |,
    Empty,
;

$export
PublicCard = |
    title String,
|

$export
PublicState ::
    Ready,
;

$export
PublicText as String

$export
public_title #= "card"

$export
make_state || -> PublicState:
    return PublicState::Ready
;

$export
render_card |card PublicCard| -> PublicText:
    label = make_private_label(card.title)
    return label.text
;

$export
render_card_or_error |card PublicCard, fail Bool| -> PublicText, Error!:
    if fail:
        return! Error("render failed")
    ;

    return render_card(card)
;
