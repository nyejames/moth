$export
BOX_SOURCE must:
    boxed |This| -> Box of Helper
;

$export
Helper = |
    text String,
|

$export
Box type T = |
    value T,
|

$export
Maker = |
    label String,
|

$export
make_maker || -> Maker:
    return Maker(label = "maker")
;

boxed |this Maker| -> Box of Helper:
    return Box(Helper(text = this.label))
;

Maker must BOX_SOURCE
