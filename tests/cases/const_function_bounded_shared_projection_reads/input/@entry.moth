Guard = |done Bool|

read_unchanged #|guard Guard, limit I32| -> I32:
    other ~= true
    loop 0 to limit:
        ~other = false
        if guard.done:
            return 0
        ;
    ;
    if other:
        return 2
    ;
    return 1
;

unchanged #I32 = read_unchanged(Guard(false), 60000)
~[:unchanged=[unchanged]]
