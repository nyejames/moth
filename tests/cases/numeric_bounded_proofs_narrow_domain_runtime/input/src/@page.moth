-- Explicit operand widening preserves the wide numerical witnesses.
-- Separate narrow operations assert completion and exact overflow edges.
-- HTML renders all exact values from parameter operands without constant folding.
-- Other operations retain checked failure, including wide_minus_zero's
-- subtraction after an infallible cast, division, power and the final pair-add.
-- HTML-Wasm rejects recoverable numeric capability at the widened sum,
-- before runtime, rather than computing and rendering the values.

u8_sum |left U8, right U8| -> U32:
    wide_left U32 = cast left
    wide_right U32 = cast right
    return wide_left + wide_right
;

i16_pair_sum |left I16, right I16| -> I32:
    wide_left I32 = cast left
    wide_right I32 = cast right
    return wide_left + wide_right
;

i8_difference |left I8, right I8| -> I32:
    wide_left I32 = cast left
    wide_right I32 = cast right
    return wide_left - wide_right
;

i16_unsigned_difference |left I16, right U16| -> I32:
    return left - right
;

wide_minus_zero |value U32| -> I64:
    wide I64 = cast value
    return wide - 0
;

zero_minus_wide |value U32| -> I64:
    wide I64 = cast value
    return 0 - wide
;

i8_product |left I8, right I8| -> I32:
    wide_left I32 = cast left
    wide_right I32 = cast right
    return wide_left * wide_right
;

u16_product |left U16, right U16| -> U32:
    wide_left U32 = cast left
    wide_right U32 = cast right
    return wide_left * wide_right
;

i16_unsigned_product |left I16, right U16| -> I32:
    return left * right
;

negate_i8 |value I8| -> I32:
    wide I32 = cast value
    return -wide
;

i16_halve |value I16| -> I16:
    return value // 2
;

u16_last_bit |value U16| -> U16:
    return value % 2
;

i64_halve |value I64| -> I64:
    return value // 2
;

i64_parity |value I64| -> I64:
    return value % 2
;

i64_identity |value I64| -> I64:
    return value + 0
;

u64_identity |value U64| -> U64:
    return value + 0
;

u64_third |value U64| -> U64:
    return value // 3
;

u64_parity |value U64| -> U64:
    return value % 2
;

u32_wide_product |value U32| -> U64:
    wide U64 = cast value
    return wide * wide
;

power_u8 |base U8, exponent U8| -> U32:
    wide U32 = cast base
    power U32 = cast exponent
    return wide ^ power
;

i32_pair_add |left I32, right I32| -> I32:
    return left + right
;

u8_add = u8_sum(200, 100)
i16_add = i16_pair_sum(-30000, 20000)
i8_sub = i8_difference(-128, 127)
i16u16_sub = i16_unsigned_difference(-32768, 65535)
wide_sub_high = wide_minus_zero(4294967295)
wide_sub_low = zero_minus_wide(4294967295)
i8_mul = i8_product(-128, -128)
u16_mul = u16_product(65535, 65535)
i16u16_mul = i16_unsigned_product(-32768, 65535)
neg_min_i8 = negate_i8(-128)
neg_zero_i8 = negate_i8(0)
halve_i16 = i16_halve(-7)
odd_bit_u16 = u16_last_bit(65535)
even_bit_u16 = u16_last_bit(65534)
halve_i64 = i64_halve(-9223372036854775808)
parity_i64 = i64_parity(-9223372036854775807)
identity_i64_min = i64_identity(-9223372036854775808)
identity_i64_max = i64_identity(9223372036854775807)
identity_u64_max = u64_identity(18446744073709551615)
third_u64 = u64_third(18446744073709551615)
parity_u64 = u64_parity(18446744073709551615)
wide_mul = u32_wide_product(4294967295)
power_boundary = power_u8(2, 31)
retained_add = i32_pair_add(2147483646, 1)

[:bounded proofs u8=[u8_add] i16=[i16_add] i8sub=[i8_sub] i16u16sub=[i16u16_sub] wide-high=[wide_sub_high] wide-low=[wide_sub_low] i8mul=[i8_mul] u16mul=[u16_mul] i16u16mul=[i16u16_mul] neg-min=[neg_min_i8] neg-zero=[neg_zero_i8] halve=[halve_i16] lastbit=[odd_bit_u16]/[even_bit_u16] halve64=[halve_i64] parity64=[parity_i64] i64min=[identity_i64_min] i64max=[identity_i64_max] u64max=[identity_u64_max] u64third=[third_u64] u64parity=[parity_u64] widemul=[wide_mul] power=[power_boundary] retained=[retained_add]]
narrow_add |left U8, right U8| -> U8, Error!:
    return left + right
;
narrow_sub |left I8, right I8| -> I8, Error!:
    return left - right
;
narrow_mul |left U16, right U16| -> U16, Error!:
    return left * right
;
narrow_neg |value I8| -> I8, Error!:
    return -value
;
narrow_power |base U8, exponent U8| -> U8, Error!:
    return base ^ exponent
;
safe_mixed |left I8, right U8| -> I16:
    return left + right
;
add_code ~U32 = 0
failed_add = narrow_add(200, 100) catch |error|:
    add_code = error.code
    then 0
;
sub_code ~U32 = 0
failed_sub = narrow_sub(-128, 127) catch |error|:
    sub_code = error.code
    then 0
;
mul_code ~U32 = 0
failed_mul = narrow_mul(65535, 65535) catch |error|:
    mul_code = error.code
    then 0
;
neg_code ~U32 = 0
failed_neg = narrow_neg(-128) catch |error|:
    neg_code = error.code
    then 0
;
power_code ~U32 = 0
failed_power = narrow_power(2, 31) catch |error|:
    power_code = error.code
    then 0
;
safe_add = narrow_add(200, 55) catch:
    then 0
;
mixed_sum = safe_mixed(-128, 255)
[:D15 narrow safe=[safe_add] mixed=[mixed_sum] codes=[add_code]/[sub_code]/[mul_code]/[neg_code]/[power_code] results=[failed_add]/[failed_sub]/[failed_mul]/[failed_neg]/[failed_power]]