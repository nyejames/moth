-- Call arguments borrow rather than consume: a mutable argument is passed with
-- the explicit `~` marker, a shared string argument stays readable after the
-- call, and the caller's own bindings remain usable. Each returned value and
-- each post-call read is named in one top-level output event.

increment |value ~Int| -> Int:
    result = value + 1
    return result
;

echo_text |text String| -> String:
    return [text]
;

number ~= 42
incremented = increment(~number)

message = "hello"
echoed = echo_text(message)

[:borrow_checker_function_calls incremented=[incremented] echoed=[echoed] message=[message]]
