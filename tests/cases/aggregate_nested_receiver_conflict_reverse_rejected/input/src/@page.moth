-- The declarations match the forward nested conflict, so only the receiver traversal
-- order changes. The later U64 receiver is primary and the earlier I64 receiver is secondary.
receive_u64_grid |grid {{U64}}| -> String:
    return ""
;

receive_i64_grid |grid {{I64}}| -> String:
    return ""
;

grid = {{1, 2}}
first = receive_i64_grid(grid)
second = receive_u64_grid(grid)

[:unreachable]
