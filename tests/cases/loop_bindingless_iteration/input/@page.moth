items = {2, 4, 6}
item_count ~= 0

loop items:
    ~item_count = item_count + 1
;

range_count ~= 0
loop 0 to 3:
    ~range_count = range_count + 1
;

-- A bindingless header still accepts a signed step and visits only the
-- selected source positions.
stride_items = {10, 20, 30, 40, 50}
stride_count ~= 0
loop stride_items by 2:
    ~stride_count += 1
;

reverse_count ~= 0
loop stride_items by -2:
    ~reverse_count += 1
;

[:loop_bindingless_iteration item_count=[item_count] range_count=[range_count] stride_count=[stride_count] reverse_count=[reverse_count]]
