-- A compile-time template constant is a RenderableTemplate String, not a literal.
-- Both plain-text and structural payloads must reach the decorator unchanged.
plain_prefix #= [:<strong>]
structural_prefix #= [:<img src="[@assets/mark.svg]" data-site="[@/]" alt="mark">]

plain_rows = [$before plain_prefix, $after [$html:</strong>]:[$slot]]
structural_rows = [$before structural_prefix:[$slot]]

~[:[plain_rows:[:text]][structural_rows:[:structural]]]
