-- Regression: the receiver's `$children` wrapper declares the named `row_style`
-- slot. The receiver owns a fixed first child before its default slot, so that
-- child keeps its occurrence-keyed wrapper overlay instead of passing through
-- slot expansion. The enclosing application's named contribution must reach the
-- fixed child, an ordinary contributed sibling, and genuinely runtime
-- conditional and loop children, while a false condition and a zero-iteration
-- loop produce no row at all.
identity |value I32| -> I32:
    return value
;

rows = [$children([$html:<tr style="[$slot row_style]">[$slot]</tr>]):[:fixed][$slot]]

show_condition = 1
skip_condition = 2
loop_limit = 2
empty_limit = 0

[rows:[$in row_style:background: red;][:contributed][if identity(show_condition) < 2:[:shown]][if identity(skip_condition) < 2:[:hidden]][loop 0 to identity(loop_limit) |loop_item|:[:row-[loop_item]]][loop 0 to identity(empty_limit) |empty_item|:[:row-no-output]]]
