-- A mutable alias declared from an immutable parameter may be read, but it cannot
-- carry mutable access back out. Passing it through `~` must be rejected before the
-- parameter's public summary is published.

set_two |value ~I32|:
    ~value = 2
;

call_then_fact |divisor I32| -> I32:
    $infallible
    n ~I32 = divisor
    set_two(~n)
    return 10 // n
;

out = call_then_fact(4)
io.line([: out=[out]])
