-- Loop CFG lowering inside fallible functions. Authored arithmetic and compiler-generated
-- iteration-index and range-value updates must continue from the live success block emitted
-- by checked lowering. The final endpoint update is skipped when no next iteration exists.

LoopFault = |
    reason String,
|

sum_items |items {Int}| -> Int, Error!:
    total ~= 0
    loop items |item|:
        total = total + item
    ;
    return total
;

count_ascending |limit Int| -> Int, Error!:
    seen ~= 0
    loop 0 to limit |i|:
        seen = seen + 1
    ;
    return seen
;

-- Negative `by` is normalised to a magnitude and then negated again for the descending
-- direction. Both of those are generated checked subtractions.
sum_descending || -> Int, Error!:
    total ~= 0
    loop 10 to & 0 by -2 |i|:
        total = total + i
    ;
    return total
;

-- The inclusive maximum endpoint is visited, then the loop exits without an overflowing
-- increment past Int::MAX.
walk_to_int_max || -> Int, Error!:
    visited ~= 0
    loop 2147483645 to & 2147483647 |i|:
        visited = visited + 1
    ;
    return visited
;

-- A custom error slot requires explicit mapping of the authored numeric failure.
-- The collection loop still exercises its generated iteration update and success continuation.
count_with_custom_error |items {Int}| -> Int, LoopFault!:
    seen ~= 0
    loop items |item|:
        seen = seen + 1 catch:
            return! LoopFault("count overflow")
        ;
    ;
    return seen
;

collection_total = sum_items({1, 2, 3, 4}) catch then -1
ascending_count = count_ascending(4) catch then -1
descending_total = sum_descending() catch then -1
custom_error_count = count_with_custom_error({5, 6, 7}) catch then -1

endpoint_count = walk_to_int_max() catch then -1

[:loop_generated_arithmetic_in_fallible_function collection=[collection_total] ascending=[ascending_count] descending=[descending_total] custom=[custom_error_count] endpoint_count=[endpoint_count]]
