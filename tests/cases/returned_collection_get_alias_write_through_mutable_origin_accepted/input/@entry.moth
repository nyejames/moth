-- Writing a fresh collection through a mutable alias of a projected field is legal when the
-- alias's value provenance stays on mutable storage: replacing the projected field's value does
-- not borrow the immutable `rows` parameter.

Pair = | first {I32} |

first |rows {{I32}}| -> {I32}, Error!:
    return rows.get(0)!
;

overwrite |rows {{I32}}| -> I32:
    data ~= {1, 2}
    pair ~= Pair(first = data)
    writer ~{I32} = {0}
    ~writer = pair.first
    ~writer = {4}
    return rows.length()
;

entry_data {{I32}} = {{9}}
size = overwrite(entry_data)
io.line([: returned_collection_get_alias_write_through size=[size]])
