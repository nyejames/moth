-- Explicit conversion of a non-constant I32 call result exercises runtime casting.
--
-- pass_through(4) arrives through a function call rather than a folded literal.
-- The body stays trap-free so the same source also covers the Wasm backend.
-- The converted F64 binding is a copy: reassigning the mutable I32 afterwards
-- leaves the snapshot unchanged.

pass_through |value I32| -> I32:
    return value
;

result F64 = cast pass_through(4)

counter ~I32 = 5
snapshot F64 = cast counter
counter = 7

[:coerced call=[result] snapshot=[snapshot] reassigned=[counter]]
