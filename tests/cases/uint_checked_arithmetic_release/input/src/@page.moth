@imported shared_total

-- Task 2B: checked U32 folding, failure recovery, comparison and compound
-- write-back. Folded rows compute at compile time; dynamic rows recover
-- through catch and builtin Error!.

zero_power U32 = 0 ^ 0

k #U32 = 1 + 2
cu #U32 = 3
k2 #Dec2 = cu + 0.5
small_check #Bool = cu < 5
imported_check #Bool = shared_total is 42

dims #= (w = cu)
total U32 = dims.w + (1 + 2)

sub |a U32, b U32| -> U32, Error!:
    return a - b
;

floor_div |a U32, b U32| -> U32, Error!:
    return a // b
;

remainder_of |a U32, b U32| -> U32, Error!:
    return a % b
;

real_div |a U32, b U32| -> F64, Error!:
    return a / b
;

under_code ~U32 = 0
underflow U32 = sub(0, 1) catch |under_err|:
    under_code = under_err.code
    then 99
;
div_failure U32 = floor_div(7, 0) catch:
    then 98
;
rem_failure U32 = remainder_of(7, 0) catch:
    then 97
;
real_failure F64 = real_div(7, 0) catch:
    then -1.0
;

neg_less |value U32, neg I32| -> Bool, Bool, Bool:
    return neg < value, value > neg, value is 0
;

neg_before Bool, neg_after Bool, neg_equal Bool = neg_less(0, -1)

add_checked |target ~U32, delta U32| -> U32, Error!:
    target += delta
    return target
;

next |calls ~I32, value U32| -> U32:
    calls += 1
    return value
;

add_next |target ~U32, calls ~I32, value U32| -> U32, Error!:
    target += next(~calls, value)
    return target
;

atomic_target ~U32 = 100
atomic_calls ~I32 = 0
atomic_code ~U32 = 0
atomic_result U32 = add_next(~atomic_target, ~atomic_calls, 4294967295) catch |atomic_err|:
    atomic_code = atomic_err.code
    then 0
;

overwrite |target ~U32, a U32, b U32| -> U32, Error!:
    target += floor_div(a, b) catch:
        then 1
    ;
    return target
;

wback ~U32 = 4294967295
wback_code ~U32 = 0
wback_result U32 = overwrite(~wback, 1, 0) catch |wback_err|:
    wback_code = wback_err.code
    then 0
;

halve |target ~U32, divisor U32| -> U32, Error!:
    target /= divisor
    return target
;

sharp ~U32 = 10
sharp_result = halve(~sharp, 4) catch:
    then 0
;
tiny ~U32 = 1
tiny_result = halve(~tiny, 2) catch:
    then 0
;

floored ~U32 = 7
floored //= 2
remained ~U32 = 7
remained %= 3
reduced ~U32 = 10
reduced -= 1 + 2

-- Task 3: U32 values above the I32 maximum execute through the shared
-- Number-carrier helpers with unsigned bounds.
add_wide |a U32, b U32| -> U32, Error!:
    return a + b
;

mul_wide |a U32, b U32| -> U32, Error!:
    return a * b
;

just_below U32 = add_wide(2147483647, 0) catch:
    then 0
;
just_above U32 = add_wide(2147483648, 1) catch:
    then 0
;
top U32 = add_wide(4294967295, 0) catch:
    then 0
;
top_plus_one U32 = add_wide(4294967295, 1) catch:
    then 7
;
-- 65535 * 65537 lands exactly on the U32 maximum.
boundary_product U32 = mul_wide(65535, 65537) catch:
    then 0
;
large_product U32 = mul_wide(100000, 100000) catch:
    then 8
;

wide_below |edge U32, limit I32| -> Bool, Bool:
    return limit < edge, edge > limit
;

wide_low Bool, wide_high Bool = wide_below(2147483648, 2147483647)
wide_top Bool, wide_top_after Bool = wide_below(4294967295, -1)

-- Explicit U32 receiver to F64 return converts at the declared precision.
wide_to_float |value U32| -> F64:
    return cast value
;

wide_float F64 = wide_to_float(3000000001)

-- Folded and dynamic evaluation of the same boundary value agree.
folded_top #U32 = 4294967295
folded_top_plus_one U32 = folded_top + 0
dynamic_top U32 = add_wide(4294967295, 0) catch:
    then 0
;
folded_dynamic_agree Bool = folded_top_plus_one is dynamic_top

[:uint checked zero=[zero_power] const=[k]/[cu]/[k2]/[small_check]/[imported_check] record=[dims.w]/[total] under=[underflow]/[under_code] div=[div_failure] rem=[rem_failure] real=[real_failure] neg=[neg_before]/[neg_after]/[neg_equal] atomic=[atomic_code]/[atomic_target]/[atomic_calls]/[atomic_result] wback=[wback_code]/[wback]/[wback_result] divassign=[sharp]/[sharp_result]/[tiny]/[tiny_result] floored=[floored] rem=[remained] reduced=[reduced] wide=[just_below]/[just_above]/[top]/[top_plus_one] prod=[boundary_product]/[large_product] compare=[wide_low]/[wide_high]/[wide_top]/[wide_top_after] converted=[wide_float] agree=[folded_dynamic_agree]]
