-- An explicit template range step owns a generated zero-step guard even without an ordinal
-- binding. The folded assertion lowers as a runtime check, so the template loop stays live and
-- both profiles must reject the authored step's fast guard.
always_false || -> Bool:
    return false
;

$fast_math $safe_math
render_step |limit I32| -> String:
    assert(always_false())
    return [: [loop 0 to limit by 2 |item|:<p>[item]</p>;] ]
;

~[render_step(2)]
