load_user || -> String, F64, Error!:
    return! Error("missing")
;

recover || -> String, F64:
    name ~= "initial"
    score ~F64 = 1.0
    ~name, ~score = load_user() catch:
        then "guest", 0.0
    ;
    return name, score
;

name, score = recover()
io.line("value catch multi bind")
io.line([: [name]])
io.line([: [score]])
