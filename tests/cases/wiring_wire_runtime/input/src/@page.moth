read_text |value Wire of String| -> String:
    return value
;

forward_text |value Wire of String| -> String:
    return read_text(value)
;

read_number |value Wire of I32| -> I32:
    return value
;

forward_number |value Wire of I32| -> I32:
    return read_number(value)
;

immutable_value = "initial"
mutable_value ~= "before"
mutable_value = "after"
read_result = read_text(immutable_value)
forward_result = forward_text(immutable_value)
mutable_result = forward_text(mutable_value)
number_value = 7
number_result = forward_number(number_value)
second ~= false
running ~= true
loop_text ~= ""
loop running:
    fresh ~= "a"
    if second:
        fresh = "b"
        running = false
    ;
    loop_text = [:[loop_text][forward_text(fresh)]]
    second = true
;

[:wire read=[read_result] forward=[forward_result] mutable=[mutable_result] number=[number_result] loop=[loop_text]]
