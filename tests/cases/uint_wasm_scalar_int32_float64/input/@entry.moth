-- Task 4 with exact I32/F64: U32 boundary values execute in the Wasm lane
-- through the shared I32 carrier with unsigned opcodes, unsigned rendering and
-- exact U32/I32 comparisons. Literal arithmetic folds before the backend;
-- dynamic comparisons, conversions and formatting exercise the supported scalar paths.
compare_below |limit I32, edge U32| -> String:
    return if limit < edge then "yes" else "no"
;

compare_above |edge U32, limit I32| -> String:
    return if edge > limit then "yes" else "no"
;

compare_equal |edge U32, other U32| -> String:
    return if edge is other then "yes" else "no"
;

just_below U32 = 2147483647 + 0
just_above U32 = 2147483648 + 1
top U32 = 4294967295 + 0
carry U32 = 3000000001 + 1000000000
small_diff U32 = 5 - 3
boundary_product U32 = 65535 * 65537
third U32 = 7 // 2
rest U32 = 7 % 3

above_text String = compare_below(2147483647, just_above)
top_text String = compare_equal(top, 4294967295)
neg_zero_text String = compare_below(-1, 0)
neg_top_text String = compare_below(-1, top)
wide_max_text String = compare_above(just_above, 2147483647)
top_neg_text String = compare_above(top, -1)

-- U32 converts directly to exact F64 with no signed intermediate.
converted_to_float |value U32| -> F64:
    return cast value
;

explicit_to_float |value U32| -> F64:
    return cast value
;

converted_from_uint F64 = converted_to_float(3000000001)
explicit_from_uint F64 = explicit_to_float(carry)
fmt_carry String = cast carry
fmt_top String = cast top

[:uint wasm32 wide=[just_below]/[just_above]/[top]/[carry]/[small_diff]/[boundary_product]/[third]/[rest] compare=[above_text]/[top_text]/[neg_zero_text]/[neg_top_text]/[wide_max_text]/[top_neg_text] float=[converted_from_uint]/[explicit_from_uint] fmt=[fmt_carry]/[fmt_top]]
