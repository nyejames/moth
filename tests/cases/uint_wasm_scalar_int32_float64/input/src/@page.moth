-- Task 4 under Int32/Float64: Uint32 boundary values execute in the Wasm lane
-- through the shared I32 carrier with unsigned opcodes, unsigned rendering and
-- exact Uint/Int comparisons. Literal arithmetic folds before the backend;
-- dynamic comparisons, conversions and formatting exercise the supported scalar paths.
compare_below |limit Int, edge Uint| -> String:
    return if limit < edge then "yes" else "no"
;

compare_above |edge Uint, limit Int| -> String:
    return if edge > limit then "yes" else "no"
;

compare_equal |edge Uint, other Uint| -> String:
    return if edge is other then "yes" else "no"
;

just_below Uint = 2147483647 + 0
just_above Uint = 2147483648 + 1
top Uint = 4294967295 + 0
carry Uint = 3000000001 + 1000000000
small_diff Uint = 5 - 3
boundary_product Uint = 65535 * 65537
third Uint = 7 // 2
rest Uint = 7 % 3

above_text String = compare_below(2147483647, just_above)
top_text String = compare_equal(top, 4294967295)
neg_zero_text String = compare_below(-1, 0)
neg_top_text String = compare_below(-1, top)
wide_max_text String = compare_above(just_above, 2147483647)
top_neg_text String = compare_above(top, -1)

-- Uint converts directly to the profile Float with no signed intermediate.
implicit_to_float |value Uint| -> Float:
    return value
;

explicit_to_float |value Uint| -> Float:
    return cast value
;

implicit_from_uint Float = implicit_to_float(3000000001)
explicit_from_uint Float = explicit_to_float(carry)
fmt_carry String = cast carry
fmt_top String = cast top

[:uint wasm32 wide=[just_below]/[just_above]/[top]/[carry]/[small_diff]/[boundary_product]/[third]/[rest] compare=[above_text]/[top_text]/[neg_zero_text]/[neg_top_text]/[wide_max_text]/[top_neg_text] float=[implicit_from_uint]/[explicit_from_uint] fmt=[fmt_carry]/[fmt_top]]
