-- Task 4 with exact I64/F64: U64 boundary values execute in
-- the Wasm lane through the shared I64 carrier with unsigned opcodes, unsigned
-- rendering and exact U64/I64 comparisons. Literal arithmetic folds before the
-- backend; dynamic comparisons, conversions and formatting exercise the
-- supported scalar paths.
compare_below |limit I64, edge U64| -> String:
    return if limit < edge then "yes" else "no"
;

compare_above |edge U64, limit I64| -> String:
    return if edge > limit then "yes" else "no"
;

compare_equal |edge U64, other U64| -> String:
    return if edge is other then "yes" else "no"
;

above U64 = 9223372036854775808 + 0
kept_above U64 = 9223372036854775808 + 100
huge U64 = 18446744073709551615 + 0
max_signed I64 = 9223372036854775807
min_signed I64 = -9223372036854775808

above_less_text String = compare_below(max_signed, above)
above_equal_text String = compare_equal(huge, 18446744073709551615)
above_above_max_text String = compare_above(above, max_signed)
min_below_zero_text String = compare_below(min_signed, 0)
zero_above_min_text String = compare_above(0, min_signed)

-- A U64 function parameter converts to exact F64 at runtime. Under
-- F64, 9007199254740993 rounds to 9007199254740992.
converted_to_float |value U64| -> F64:
    return cast value
;

explicit_to_float |value U64| -> F64:
    return cast value
;

witness U64 = 9007199254740993
converted_witness F64 = converted_to_float(witness)
explicit_witness F64 = explicit_to_float(witness)
witness_match_text String = if converted_witness is 9007199254740992.0 then "yes" else "no"
witness_agree_text String = if converted_witness is explicit_witness then "yes" else "no"
fmt_above String = cast above
fmt_huge String = cast huge

[:uint wasm64f64 wide=[kept_above]/[huge] compare=[above_less_text]/[above_equal_text]/[above_above_max_text]/[min_below_zero_text]/[zero_above_min_text] float=[converted_witness]/[explicit_witness]/[witness_match_text]/[witness_agree_text] fmt=[fmt_above]/[fmt_huge]]
