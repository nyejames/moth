$export
DISPLAY_TEXT must:
    display |This| -> String
;

$export
Label = |
    text String,
|

$export
LabelBox type Item is DISPLAY_TEXT = |
    value Item,
|

$export
make_label |text String| -> Label:
    return Label(text)
;

display |this Label| -> String:
    return this.text
;

Label must DISPLAY_TEXT
