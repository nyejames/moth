-- Const U64 ranges fold through the unsigned
-- cursor. Both literal and `#U64` constant bounds iterate, the inclusive
-- U64 maximum terminates without a successor, and descending to zero
-- stops without underflowing.

uint_start #U64 = 1
uint_end #U64 = 3
uint_step #U64 = 1
uint_two #U64 = 2
uint_zero #U64 = 0
uint_near_max #U64 = 18446744073709551613
uint_max #U64 = 18446744073709551615
mixed_start #F32 = 0.0
mixed_end #F32 = 2.0
mixed_step #F32 = 1.0
mixed_bound #F32 = 2.0
mixed_bound_step #F32 = 1.0
#[loop 1 to & 3 |i|:
    uint-literal-incl-[i];
]

#[loop 3 to & 1 by 1 |i|:
    uint-literal-desc-[i];
]

#[loop uint_start to & uint_end by uint_step |i|:
    uint-const-asc-[i];
]

#[loop uint_end to & uint_start by uint_step |i|:
    uint-const-desc-[i];
]

#[loop uint_two to & uint_zero by uint_step |i|:
    uint-const-desc-to-zero-[i];
]

#[loop uint_near_max to & uint_max |i|:
    uint-const-near-max-[i];
]

#[loop mixed_start to & mixed_end by mixed_step |i|:
    uint-mixed-step-[i];
]

#[loop mixed_start to & mixed_bound by mixed_bound_step |i|:
    uint-mixed-bound-[i];
]
