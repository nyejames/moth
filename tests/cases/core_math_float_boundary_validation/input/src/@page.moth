@core/math sqrt, exp as exponential, log, log1p, asin, acos, acosh, atanh, abs
@core/math

finite_direct = sqrt(16.0)
finite_namespace = math.sqrt(16.0)

-- `exp` approximates, so the alias path is bounded against the six-decimal
-- reference rather than fixed to the host's exact decimal rendering.
finite_alias = exponential(1.0)
alias_ok = abs(finite_alias - 2.718282) < 0.000001

invalid_sqrt || -> Float, Error!:
    return sqrt(-1.0)
;

invalid_exp || -> Float, Error!:
    return math.exp(10000.0)
;

invalid_alias_exp || -> Float, Error!:
    return exponential(10000.0)
;

invalid_log_zero || -> Float, Error!:
    return log(0.0)
;

invalid_log_negative || -> Float, Error!:
    return math.log(-1.0)
;

invalid_asin_above_one || -> Float, Error!:
    return asin(1.5)
;

invalid_asin_below_minus_one || -> Float, Error!:
    return asin(-1.5)
;

invalid_acos_above_one || -> Float, Error!:
    return acos(1.5)
;

invalid_acosh_below_one || -> Float, Error!:
    return acosh(0.5)
;

invalid_atanh_at_one || -> Float, Error!:
    return atanh(1.0)
;

invalid_atanh_beyond_one || -> Float, Error!:
    return atanh(1.5)
;

invalid_log1p_at_minus_one || -> Float, Error!:
    return log1p(-1.0)
;

invalid_log1p_below_minus_one || -> Float, Error!:
    return log1p(-1.5)
;

sqrt_code ~U32 = 0
sqrt_value = invalid_sqrt() catch |sqrt_err|:
    sqrt_code = sqrt_err.code
    then 0
;
exp_code ~U32 = 0
exp_value = invalid_exp() catch |exp_err|:
    exp_code = exp_err.code
    then 0
;
alias_exp_code ~U32 = 0
alias_exp_value = invalid_alias_exp() catch |alias_err|:
    alias_exp_code = alias_err.code
    then 0
;
log_zero_code ~U32 = 0
log_zero_value = invalid_log_zero() catch |log_zero_err|:
    log_zero_code = log_zero_err.code
    then 0
;
log_negative_code ~U32 = 0
log_negative_value = invalid_log_negative() catch |log_negative_err|:
    log_negative_code = log_negative_err.code
    then 0
;
asin_above_code ~U32 = 0
asin_above_value = invalid_asin_above_one() catch |asin_above_err|:
    asin_above_code = asin_above_err.code
    then 0
;
asin_below_code ~U32 = 0
asin_below_value = invalid_asin_below_minus_one() catch |asin_below_err|:
    asin_below_code = asin_below_err.code
    then 0
;
acos_above_code ~U32 = 0
acos_above_value = invalid_acos_above_one() catch |acos_above_err|:
    acos_above_code = acos_above_err.code
    then 0
;
acosh_below_code ~U32 = 0
acosh_below_value = invalid_acosh_below_one() catch |acosh_below_err|:
    acosh_below_code = acosh_below_err.code
    then 0
;
atanh_at_one_code ~U32 = 0
atanh_at_one_value = invalid_atanh_at_one() catch |atanh_at_one_err|:
    atanh_at_one_code = atanh_at_one_err.code
    then 0
;
atanh_beyond_code ~U32 = 0
atanh_beyond_value = invalid_atanh_beyond_one() catch |atanh_beyond_err|:
    atanh_beyond_code = atanh_beyond_err.code
    then 0
;
log1p_at_minus_one_code ~U32 = 0
log1p_at_minus_one_value = invalid_log1p_at_minus_one() catch |log1p_at_err|:
    log1p_at_minus_one_code = log1p_at_err.code
    then 0
;
log1p_below_code ~U32 = 0
log1p_below_value = invalid_log1p_below_minus_one() catch |log1p_below_err|:
    log1p_below_code = log1p_below_err.code
    then 0
;

[:core_math_float_boundary_validation finite=[finite_direct] namespace=[finite_namespace] alias=[alias_ok] errors=[sqrt_code]/[exp_code]/[alias_exp_code]/[log_zero_code]/[log_negative_code]/[asin_above_code]/[asin_below_code]/[acos_above_code]/[acosh_below_code]/[atanh_at_one_code]/[atanh_beyond_code]/[log1p_at_minus_one_code]/[log1p_below_code]]
