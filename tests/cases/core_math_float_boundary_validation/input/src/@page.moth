@core/math sqrt, exp as exponential, log, log1p, asin, acos, acosh, atanh, abs
@core/math

finite_direct = sqrt(16.0)
finite_namespace = math.sqrt(16.0)

-- `exp` approximates, so the alias path is bounded against the six-decimal
-- reference rather than fixed to the host's exact decimal rendering.
finite_alias = exponential(1.0)
alias_ok = abs(finite_alias - 2.718282) < 0.000001

invalid_sqrt || -> Float, Error!:
    return sqrt(-1.0)
;

invalid_exp || -> Float, Error!:
    return math.exp(10000.0)
;

invalid_alias_exp || -> Float, Error!:
    return exponential(10000.0)
;

invalid_log_zero || -> Float, Error!:
    return log(0.0)
;

invalid_log_negative || -> Float, Error!:
    return math.log(-1.0)
;

invalid_asin_above_one || -> Float, Error!:
    return asin(1.5)
;

invalid_asin_below_minus_one || -> Float, Error!:
    return asin(-1.5)
;

invalid_acos_above_one || -> Float, Error!:
    return acos(1.5)
;

invalid_acosh_below_one || -> Float, Error!:
    return acosh(0.5)
;

invalid_atanh_at_one || -> Float, Error!:
    return atanh(1.0)
;

invalid_atanh_beyond_one || -> Float, Error!:
    return atanh(1.5)
;

invalid_log1p_at_minus_one || -> Float, Error!:
    return log1p(-1.0)
;

invalid_log1p_below_minus_one || -> Float, Error!:
    return log1p(-1.5)
;

sqrt_code = invalid_sqrt() catch |sqrt_err|:
    then sqrt_err.code
;
exp_code = invalid_exp() catch |exp_err|:
    then exp_err.code
;
alias_exp_code = invalid_alias_exp() catch |alias_err|:
    then alias_err.code
;
log_zero_code = invalid_log_zero() catch |log_zero_err|:
    then log_zero_err.code
;
log_negative_code = invalid_log_negative() catch |log_negative_err|:
    then log_negative_err.code
;
asin_above_code = invalid_asin_above_one() catch |asin_above_err|:
    then asin_above_err.code
;
asin_below_code = invalid_asin_below_minus_one() catch |asin_below_err|:
    then asin_below_err.code
;
acos_above_code = invalid_acos_above_one() catch |acos_above_err|:
    then acos_above_err.code
;
acosh_below_code = invalid_acosh_below_one() catch |acosh_below_err|:
    then acosh_below_err.code
;
atanh_at_one_code = invalid_atanh_at_one() catch |atanh_at_one_err|:
    then atanh_at_one_err.code
;
atanh_beyond_code = invalid_atanh_beyond_one() catch |atanh_beyond_err|:
    then atanh_beyond_err.code
;
log1p_at_minus_one_code = invalid_log1p_at_minus_one() catch |log1p_at_err|:
    then log1p_at_err.code
;
log1p_below_code = invalid_log1p_below_minus_one() catch |log1p_below_err|:
    then log1p_below_err.code
;

[:core_math_float_boundary_validation finite=[finite_direct] namespace=[finite_namespace] alias=[alias_ok] errors=[sqrt_code]/[exp_code]/[alias_exp_code]/[log_zero_code]/[log_negative_code]/[asin_above_code]/[asin_below_code]/[acos_above_code]/[acosh_below_code]/[atanh_at_one_code]/[atanh_beyond_code]/[log1p_at_minus_one_code]/[log1p_below_code]]
