panel = [:
    <section>
        <div class="plain">[$slot("item")]</div>
        [$children([:<strong>[$slot]</strong>]):
            <div class="wrapped">[$slot("item")]</div>
        ]
        [$slot]
    </section>
]

show = true
label = "runtime"
empty_producer_calls ~{Int} = {}

empty_producer |calls ~{Int}| -> String:
    ~calls.push(1)
    return ""
;

rendered = [panel:
    [$insert("item"):
        [if show:
            value [label]
        ]
    ]
    [$insert("item"):
        [empty_producer(~empty_producer_calls)]
    ]
    [$insert("item"):
        [if not show:
            structural-no-output
        ]
    ]
]

io.line(rendered)
io.line([: empty-producer-calls=[empty_producer_calls.length()]])
