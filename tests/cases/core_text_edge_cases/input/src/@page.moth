@core/text length, is_empty, contains, starts_with, ends_with
@core/text

len_empty String = cast length("")
len_ascii String = cast length("abc")
len_bmp String = cast length("é")
len_combining String = cast length("é")
len_emoji String = cast length("😊")
len_mixed String = cast length("a😊b")
len_namespace String = cast text.length("a😊b")
len_lowest_pair String = cast length("𐀀")
len_highest_lead String = cast length("􏿽")
len_highest_trail String = cast length("🏿")

empty_yes String = cast is_empty("")
empty_no String = cast is_empty("a")
empty_space String = cast is_empty(" ")

contains_empty_text String = cast contains("abc", "")
contains_empty_both String = cast contains("", "")
contains_in_empty String = cast contains("", "a")
contains_emoji String = cast contains("moth😊ball", "😊")
contains_decomposed_in_precomposed String = cast contains("é", "é")
contains_metachar String = cast contains("mothball", ".")

starts_empty_text String = cast starts_with("abc", "")
starts_empty_both String = cast starts_with("", "")
starts_in_empty String = cast starts_with("", "a")
starts_emoji String = cast starts_with("😊moth", "😊")
starts_decomposed_in_precomposed String = cast starts_with("é", "é")

ends_empty_text String = cast ends_with("abc", "")
ends_empty_both String = cast ends_with("", "")
ends_in_empty String = cast ends_with("", "a")
ends_emoji String = cast ends_with("moth😊", "😊")
ends_decomposed_in_precomposed String = cast ends_with("é", "é")

[:len_empty=[len_empty] len_ascii=[len_ascii] len_bmp=[len_bmp] len_combining=[len_combining] len_emoji=[len_emoji] len_mixed=[len_mixed] len_namespace=[len_namespace] len_lowest_pair=[len_lowest_pair] len_highest_lead=[len_highest_lead] len_highest_trail=[len_highest_trail] empty_yes=[empty_yes] empty_no=[empty_no] empty_space=[empty_space] contains_empty_text=[contains_empty_text] contains_empty_both=[contains_empty_both] contains_in_empty=[contains_in_empty] contains_emoji=[contains_emoji] contains_decomposed_in_precomposed=[contains_decomposed_in_precomposed] contains_metachar=[contains_metachar] starts_empty_text=[starts_empty_text] starts_empty_both=[starts_empty_both] starts_in_empty=[starts_in_empty] starts_emoji=[starts_emoji] starts_decomposed_in_precomposed=[starts_decomposed_in_precomposed] ends_empty_text=[ends_empty_text] ends_empty_both=[ends_empty_both] ends_in_empty=[ends_in_empty] ends_emoji=[ends_emoji] ends_decomposed_in_precomposed=[ends_decomposed_in_precomposed]]
