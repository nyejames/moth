u #U64 = 18446744073709551615
neg #I8 = -128
half #F16 = 0.1
single #F32 = 0.1
small #U8 = 200
[:[render( cast u, cast neg, cast half, cast single)]]
render |u_text String, neg_text String, half_text String, single_text String| -> String:
    return [: fixed text: [u_text] [neg_text] [half_text] [single_text] direct: [small]]
;
