pair |left Int, right Int| -> Int, String:
    return left * right, "ok"
;

multi_info ~= ""
number, label = pair(50000, 50000) catch |multi_err|:
    multi_info = [: [multi_err.code] [multi_err.message]]
    then 0, "fallback"
;

multi_report = copy multi_info
exact_number, exact_label = pair(6, 7)

[: number=[number] label=[label] report=[multi_report] exact=[exact_number] elabel=[exact_label]]
