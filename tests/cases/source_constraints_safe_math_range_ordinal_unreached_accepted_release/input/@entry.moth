-- The generated ordinal update lives in the range step block. When the body can neither fall
-- through nor `continue`, lowering discards that block, so no ordinal update runs. `$safe_math`
-- must accept the fast loop in every skip shape: live, after a terminator, and after a folded
-- assertion that lowers as a runtime check before the loop.
$fast_math $safe_math
live_break |limit I32| -> I32:
    loop 0 to limit |value, ordinal|:
        break
    ;
    return limit
;

$fast_math $safe_math
live_return |limit I32| -> I32:
    loop 0 to limit |value, ordinal|:
        return value
    ;
    return limit
;

$fast_math $safe_math
skipped_break |limit I32| -> I32:
    return limit
    loop 0 to limit |value, ordinal|:
        break
    ;
;

$fast_math $safe_math
skipped_return |limit I32| -> I32:
    return limit
    loop 0 to limit |value, ordinal|:
        return value
    ;
;

always_false || -> Bool:
    return false
;

$fast_math $safe_math
folded_assertion_break |limit I32| -> I32:
    assert(always_false())
    loop 0 to limit |value, ordinal|:
        break
    ;
    return limit
;

~[:done]
