@core/time Timestamp, timestamp_from_iso_string, timestamp_from_unix_milliseconds, unix_milliseconds, to_iso_string

parse || -> Timestamp, Error!:
    return timestamp_from_iso_string("2000-06-15T12:30:45.123456789+02:30")!
;

-- A fourth digit of nine would carry into the next second under rounding, so
-- this sample proves the extra digits truncate toward zero.
parse_truncating || -> Timestamp, Error!:
    return timestamp_from_iso_string("2000-06-15T12:30:45.9999Z")!
;

-- A negative offset inside the window is accepted and converts to UTC.
parse_negative_offset || -> Timestamp, Error!:
    return timestamp_from_iso_string("2024-01-01T12:00:00.000-05:30")!
;

-- A numeric offset converts to the UTC instant; fraction digits beyond the third truncate
ts = parse() catch |parse_err|:
    then timestamp_from_unix_milliseconds(0.0)
;
millis = unix_milliseconds(ts)
iso = to_iso_string(ts) catch |render_err|:
    then "unrenderable"
;

truncated = parse_truncating() catch |truncate_err|:
    then timestamp_from_unix_milliseconds(0.0)
;
truncated_millis = unix_milliseconds(truncated)

negative_offset = parse_negative_offset() catch |offset_err|:
    then timestamp_from_unix_milliseconds(0.0)
;
negative_offset_iso = to_iso_string(negative_offset) catch |negative_render_err|:
    then "unrenderable"
;

[: timestamp_parse_offset_and_fraction millis=[millis] iso=[iso] truncated=[truncated_millis] negative_offset=[negative_offset_iso]]
