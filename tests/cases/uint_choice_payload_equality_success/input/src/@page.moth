-- U32 values flow through the ordinary equality paths: direct scalar
-- comparison, choice payloads holding U32, optional U32 wrapping and
-- unwrapping, nested choice payloads, struct field extraction and
-- collection element extraction.
Holder ::
    Single | value U32 |,
    Pair | first U32, second U32 |,
;

Inner ::
    Count | value U32 |,
;

Outer ::
    Empty,
    Wrapped | inner Inner |,
;

Point = |
    x U32,
    y U32,
|
origin Point = Point(3, 4)

chosen Holder = Holder::Single(7)
same = chosen is Holder::Single(7)
different = chosen is Holder::Single(8)
pair_same = Holder::Pair(1, 2) is Holder::Pair(1, 2)
pair_different = Holder::Pair(1, 2) is Holder::Pair(1, 3)
variant_mismatch = Holder::Single(7) is Holder::Pair(7, 7)

maybe_present U32? = 41
maybe_missing U32? = none
forty_one U32 = 41
forty_two U32 = 42
optional_same = maybe_present is forty_one
optional_different = maybe_present is forty_two
optional_missing = maybe_missing is none
optional_present_vs_missing = maybe_present is none

nested_same = Outer::Wrapped(Inner::Count(9)) is Outer::Wrapped(Inner::Count(9))
nested_different = Outer::Wrapped(Inner::Count(9)) is Outer::Wrapped(Inner::Count(10))

field_same = origin.x is 3
field_different = origin.y is 5

items {U32} = {10, 20, 30}
first U32 = items.get(0) catch:
    then 0
;
element_same = first is 10

[:uint_choice_payload_equality same=[same] different=[different] pair_same=[pair_same] pair_different=[pair_different] variant_mismatch=[variant_mismatch] optional_same=[optional_same] optional_different=[optional_different] optional_missing=[optional_missing] optional_present_vs_missing=[optional_present_vs_missing] nested_same=[nested_same] nested_different=[nested_different] field_same=[field_same] field_different=[field_different] element_same=[element_same]]
