-- The unnamed range and literal result add no value rows per iteration. The budget runs
-- out while copying the record for the value block's projected assignment receiver.
Holder = |value I32|

apply #|limit I32| -> I32:
    holder ~= Holder(0)
    loop 0 to limit:
        ~holder.value = if true:
            then 9
        else
            then 0
        ;
    ;
    return holder.value
;

value #I32 = apply(40000)
io.line(value)
