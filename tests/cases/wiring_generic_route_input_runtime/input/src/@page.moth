EditorMessage ::
    Changed | value String |,
;

AppMessage ::
    Editor | editor_id I32, message EditorMessage |,
    Search | query String |,
;

echo_label type T |label String, event Route of T -> AppMessage| -> String:
    return label
;

editor = echo_label("editor", AppMessage::Editor(12))
search = echo_label("search", AppMessage::Search)

[:generic-input editor=[editor] search=[search]]
