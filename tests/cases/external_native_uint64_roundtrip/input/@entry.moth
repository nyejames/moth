@external_uint.js identity_uint, load_safe

-- U64 travels as BigInt inside Moth JS and crosses to foreign JS as a
-- safe Number: zero, the foreign safe-Number limit and a large exact value
-- inside the bridge all survive the round trip unchanged, including through
-- a fallible success payload.
zero U64 = identity_uint(0)
small U64 = identity_uint(17)
large U64 = identity_uint(5000000000)
safe_limit U64 = identity_uint(9007199254740991)
loaded U64 = load_safe() catch |load_err|:
    then 0
;
io.line([: external_native_uint64 zero=[zero] small=[small] large=[large] safe=[safe_limit] loaded=[loaded]])
