-- Only the if path rebinds `view` through `child`; the else path binds an unrelated allocation.
-- At the join the derivation is a must fact, so `child` is not exempt and the read stays
-- rejected.

probe |flag Bool| -> I32:
    slot ~= {1}
    parent ~= slot
    child ~= parent
    other ~= {2}
    view ~= {9}
    if flag:
        ~view = child
    else
        ~view = other
    ;
    n = view.length()
    ~child.push(2)
    return n
;

result = probe(true)
io.line([: [result]])
