-- float_format_contract: backend-stable Float and fixed-float -> String formatting coverage.
--
-- This test exercises both the compile-time/folded path and the runtime path for
-- Float -> String formatting, locking the exact output contract for all required
-- edge cases:
--   0.0       -> "0"
--   -0.0      -> "0"     (negative zero normalised)
--   1.0       -> "1"
--   1.5       -> "1.5"
--   0.000001  -> "0.000001"
--   0.0000001 -> "1e-7"  (below 1e-6 threshold uses exponential)
--   1e21      -> "1e+21"
--   -1e21     -> "-1e+21"

-- ---------------------------
--  Compile-time/folded path
-- ---------------------------
-- Float constants interpolated in a top-level template fold at compile time,
-- proving the AST constant-folding path agrees with the runtime formatter.

zero #Float = 0.0
neg_zero #Float = -0.0
one #Float = 1.0
one_half #Float = 1.5
small #Float = 0.000001
tiny #Float = 0.0000001
big #Float = 1e21
neg_big #Float = -1e21

[:folded float: [zero]|[neg_zero]|[one]|[one_half]|[small]|[tiny]|[big]|[neg_big]]

-- ---------------------
--  Runtime path
-- ---------------------
-- An explicit Float -> String cast inside a function body exercises the
-- runtime formatter on both backends.

format_value |value Float| -> String:
    text String = cast value
    return text
;

format_f16 |value F16| -> String:
    return cast value
;

format_f32 |value F32| -> String:
    return cast value
;

format_f64 |value F64| -> String:
    return cast value
;

[:runtime float: [format_value(0.0)]|[format_value(-0.0)]|[format_value(1.0)]|[format_value(1.5)]|[format_value(0.000001)]|[format_value(0.0000001)]|[format_value(1e21)]|[format_value(-1e21)]]

-- Typed function calls keep the fixed-precision cases on the runtime path.
[:runtime precision: F16 max=[format_f16(65504)]|F16 2^-6=[format_f16(0.015625)]|F32 0.1=[format_f32(0.1)]|F64 1e21=[format_f64(1e21)]]
