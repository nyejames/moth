-- Prove write-through alias semantics: struct field mutation is observable through
-- an alias created after the write, demonstrating __moth_write, __moth_assign_borrow, and __moth_read.

Counter = |
    value Int,
|

render_write_through || -> String:
    c ~= Counter(10)
    c.value = c.value + 5  -- triggers __moth_write on the computed field place
    alias = c              -- triggers __moth_assign_borrow
    -- Both reads route through __moth_read
    return [:write_through value=[c.value] alias_value=[alias.value]]
;

[:[render_write_through()]]
