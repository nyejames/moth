overflow_int |value I32| -> I32, Error!:
    return value + 1
;

divide_float |numerator F64, denominator F64| -> F64, Error!:
    return numerator / denominator
;

int_result = overflow_int(2147483647) catch:
    then -7
;
float_result = divide_float(10.0, 0.0) catch:
    then -8.5
;

[: numeric failure recovered int=[int_result] float=[float_result]]