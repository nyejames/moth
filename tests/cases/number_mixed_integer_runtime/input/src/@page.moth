mix_int |number_value Dec2, integer Int| -> String:
    number_first = number_value + integer
    integer_first = integer + number_value
    number_equal = number_value is integer
    integer_equal = integer is number_value
    return [:[number_first]/[integer_first]/[number_equal]/[integer_equal]]
;
compare_number1_int |number_value Dec1, integer Int| -> String:
    number_less = number_value < integer
    integer_greater = integer > number_value
    return [:[number_less]/[integer_greater]]
;

mix_i8 |number_value Dec2, integer I8| -> String:
    number_first = number_value + integer
    integer_first = integer + number_value
    number_equal = number_value is integer
    integer_equal = integer is number_value
    return [:[number_first]/[integer_first]/[number_equal]/[integer_equal]]
;
