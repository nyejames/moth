-- The source is used only through explicit casts, so no cast target constrains
-- it. It keeps the language default I32, which the immediate I32 receiver
-- exposes as an invalid same-type cast (invalid_cast.same_source_and_target).
-- If a cast target wrongly constrained the source, the wider casts first would
-- make the later I32 cast a valid conversion and this diagnostic would vanish.
receive_u64 |value U64| -> String:
    return cast value
;

receive_i64 |value I64| -> String:
    return cast value
;

receive_i32 |value I32| -> String:
    return cast value
;

source = 1
wide = receive_u64(cast source)
signed = receive_i64(cast source)
same_default = receive_i32(cast source)

[:unreachable]
