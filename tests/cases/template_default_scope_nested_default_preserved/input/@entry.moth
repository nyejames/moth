card #= [:<h1>[$slot title = "Untitled"]</h1><section>[$slot]</section>]
named #= [:<h1>[$slot title = "Untitled"]</h1>[$slot]]
closed_page #= [:[card:Intro]<main>[$slot]</main>]
empty_page #= [:[named:[$in title:]]<main>[$slot]</main>]
open_page #= [:<div>[named]</div>]
plain #= [named]
pos_card #= [:pos=[$slot 1 = "Card position"]|body=[$slot = "Card body"]]
pos_page #= [:[pos_card:Intro]<main>[$slot]</main>]
mixed_named #= [:<h1>[$slot title = "Mixed named title fallback"]</h1>[$slot = "Mixed named body fallback"]]
mixed_card #= [:title=[$slot title = "Mixed card title fallback"]|body=[$slot = "Mixed card body fallback"]]
mixed_page #= [:[mixed_card:[mixed_named]]<main>[$slot main]</main>]
~[:default=[closed_page:Body]|empty=[empty_page:Body]|open=[open_page:[$in title:Inline]Body]|plain=[plain:[$in title:Stored]Body]|positional=[pos_page:Body]|mixed=[mixed_page:[$in title:Outer][$in main:Body]]]
