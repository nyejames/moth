-- Task 4 with exact I32/F32: U32 boundary values execute in
-- the Wasm lane through the shared I32 carrier with unsigned opcodes, unsigned
-- rendering and exact U32/I32 comparisons. Literal arithmetic folds before the
-- backend; dynamic comparisons, conversions and formatting exercise the
-- supported scalar paths.
compare_below |limit I32, edge U32| -> String:
    return if limit < edge then "yes" else "no"
;

compare_above |edge U32, limit I32| -> String:
    return if edge > limit then "yes" else "no"
;

compare_equal |edge U32, other U32| -> String:
    return if edge is other then "yes" else "no"
;

just_below U32 = 2147483647 + 0
just_above U32 = 2147483648 + 1
top U32 = 4294967295 + 0

above_text String = compare_below(2147483647, just_above)
top_text String = compare_equal(top, 4294967295)
neg_top_text String = compare_below(-1, top)
wide_max_text String = compare_above(just_above, 2147483647)
top_neg_text String = compare_above(top, -1)

-- A U32 function parameter converts to exact F32 at runtime. Under
-- F32, 16777217 rounds to 16777216.
converted_to_float |value U32| -> F32:
    return cast value
;

explicit_to_float |value U32| -> F32:
    return cast value
;

witness U32 = 16777217
converted_witness F32 = converted_to_float(witness)
explicit_witness F32 = explicit_to_float(witness)
witness_match_text String = if converted_witness is 16777216.0 then "yes" else "no"
witness_agree_text String = if converted_witness is explicit_witness then "yes" else "no"
fmt_above String = cast just_above
fmt_top String = cast top

[:uint wasm32f32 wide=[just_below]/[just_above]/[top] compare=[above_text]/[top_text]/[neg_top_text]/[wide_max_text]/[top_neg_text] float=[converted_witness]/[explicit_witness]/[witness_match_text]/[witness_agree_text] fmt=[fmt_above]/[fmt_top]]
