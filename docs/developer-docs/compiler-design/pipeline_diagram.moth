-- Example composition for docs/developer-docs/compiler-design/@entry.moth.
-- The reusable layout and styling come from @diagrams.

@diagrams diagram,
    stage,
    node,
    branch,
    lane,
    detail,
    island,
    fanout

compiler_pipeline #= [diagram:
    [$in label: Moth compiler and build pipeline]
    [$in caption: Each box links to the walkthrough page that expands that stage. Side branches show important internal work without lengthening the main pipeline.]

    [stage:
        [node:
            [$in href: ./starting-a-build/]
            [$in eyebrow: Entry]
            [$in title: Command and project bootstrap]
            build, dev or check selects the builder, profile and tooling overlays.
        ]

        [$in details:
            [branch:
                [$in label: Internal flow]
                [lane:
                [detail:
                    [$in href: ./starting-a-build/]
                    Typed CLI inputs
                ]
                [detail:
                    [$in href: ./starting-a-build/]
                    Capability surface
                ]
                [detail:
                    [$in href: ./starting-a-build/]
                    config.moth folding
                ]
                ]
            ]
        ]
    ]

    [stage:
        [node:
            [$in href: ./project-graphs-and-modules/]
            [$in eyebrow: Stage 0 + preparation]
            [$in title: Source discovery and preparation]
            Build the canonical source index while compiler-owned preparation exposes structural dependencies and file references.
        ]

        [$in details:
            [branch:
                [$in label: Internal flow]
                [lane:
                [detail:
                    [$in href: ./project-graphs-and-modules/]
                    Source index
                ]
                [detail:
                    [$in href: ./tokenization/]
                    Tokenization
                ]
                [detail:
                    [$in href: ./declarations-dependencies-and-ordering/]
                    Header syntax preparation
                ]
                [detail:
                    [$in href: ./project-graphs-and-modules/]
                    File-reference worklist
                ]
                ]
            ]
        ]
    ]

    [stage:
        [node:
            [$in href: ./declarations-dependencies-and-ordering/]
            [$in eyebrow: Stages 2-3]
            [$in title: Interface binding and declaration order]
            Once providers are ready, bind retained dependency syntax and topologically order local declarations.
        ]

        [$in details:
            [branch:
                [$in label: Internal flow]
                [lane:
                [detail:
                    [$in href: ./project-graphs-and-modules/]
                    Completed provider interfaces
                ]
                [detail:
                    [$in href: ./declarations-dependencies-and-ordering/]
                    Interface binding
                ]
                [detail:
                    [$in href: ./declarations-dependencies-and-ordering/]
                    Local ordering
                ]
                ]
            ]
        ]
    ]

    [stage:
        [node:
            [$in href: ./ast-semantics-and-types/]
            [$in eyebrow: Stage 4]
            [$in title: AST semantics]
            Resolve types, fold constants and templates, specialise ordinary "if" control flow on a known Bool and commit generated requests.
        ]

        [$in details:
            [branch:
                [$in label: Internal flow]
                [lane:
                [detail:
                    [$in href: ./ast-semantics-and-types/]
                    Type checking
                ]
                [detail:
                    [$in href: ./compile-time-semantics/]
                    Constant folding
                ]
                [detail:
                    [$in href: ./templates-and-tir/]
                    TIR and templates
                ]
                ]
            ]
        ]
    ]

    [stage:
        [node:
            [$in href: ./hir/]
            [$in eyebrow: Stage 5]
            [$in title: HIR lowering and validation]
            Lower the active typed program into backend-neutral executable control flow.
        ]

        [$in details:
            [branch:
                [$in label: Internal flow]
                [lane:
                [detail:
                    [$in href: ./hir/]
                    Typed AST to HIR
                ]
                [detail:
                    [$in href: ./hir/]
                    CFG and invariant validation
                ]
                [detail:
                    [$in href: ./diagnostics/]
                    Structured diagnostics
                ]
                ]
            ]
        ]
    ]

    [stage:
        [node:
            [$in href: ./borrow-validation-and-drops/]
            [$in eyebrow: Stage 6]
            [$in title: Borrow validation]
            Prove legal shared and exclusive access, future use and optional transfer candidates.
        ]

        [$in details:
            [branch:
                [$in label: Internal flow]
                [lane:
                [detail:
                    [$in href: ./borrow-validation-and-drops/]
                    Places and overlap
                ]
                [detail:
                    [$in href: ./borrow-validation-and-drops/]
                    Last-use facts
                ]
                ]

                [island:
                    [$in href: ./borrow-validation-and-drops/]
                    [$in title: Boracle reference solver]
                    Research and differential validation only, outside the production pipeline.
                ]
            ]
        ]
    ]

    [stage:
        [node:
            [$in href: ./memory-management-and-gc/]
            [$in eyebrow: Analysis]
            [$in title: Lifetime topology]
            Build allocation families, retention facts and backend-neutral lifetime requirements.
        ]

        [$in details:
            [branch:
                [$in label: Internal flow]
                [lane:
                [detail:
                    [$in href: ./memory-management-and-gc/]
                    Allocation families
                ]
                [detail:
                    [$in href: ./memory-management-and-gc/]
                    Retained edges
                ]
                [detail:
                    [$in href: ./memory-management-and-gc/]
                    Intervals and frontiers
                ]
                ]
            ]
        ]
    ]

    [stage:
        [node:
            [$in href: ./module-artefacts-and-reuse/]
            [$in eyebrow: Boundary]
            [$in title: Immutable module artefacts]
            Publish successful module semantics, generated sidecars and link facts. Reuse fingerprints are planned, not a current lane.
        ]
    ]

    [stage:
        [node:
            [$in href: ./linking-entries-and-reachability/]
            [$in eyebrow: Link planning]
            [$in title: Entries and reachable unions]
            Select active roots, instantiate project lifecycles and validate the complete linked topology.
        ]

        [$in details:
            [branch:
                [$in label: Internal flow]
                [lane:
                [detail:
                    [$in href: ./linking-entries-and-reachability/]
                    Entry roots
                ]
                [detail:
                    [$in href: ./linking-entries-and-reachability/]
                    Reachability
                ]
                [detail:
                    [$in href: ./memory-management-and-gc/]
                    Complete lifetime topology
                ]
                ]
            ]
        ]
    ]

    [stage:
        [node:
            [$in href: ./target-planning-and-validation/]
            [$in eyebrow: Physical planning]
            [$in title: Target and memory planning]
            Partition functions, validate target contracts and produce one validated memory plan per physical variant.
        ]

        [$in details:
            [branch:
                [$in label: Internal flow]
                [lane:
                [detail:
                    [$in href: ./target-planning-and-validation/]
                    Target affinity
                ]
                [detail:
                    [$in href: ./target-planning-and-validation/]
                    Target validation
                ]
                [detail:
                    [$in href: ./memory-management-and-gc/]
                    ValidatedMemoryPlan
                ]
                ]
            ]
        ]
    ]

    [stage:
        [node:
            [$in href: ./backend-lowering/]
            [$in eyebrow: Backends]
            [$in title: Backend lowering]
            Lower each selected physical variant without reopening source semantics.
        ]

        [$in details:
            [branch:
                [$in label: Output paths]
                [fanout:
                [detail:
                    [$in href: ./backend-lowering/]
                    JavaScript
                ]
                [detail:
                    [$in href: ./backend-lowering/]
                    WebAssembly
                ]
                [detail:
                    [$in href: ./html-assembly-and-output/]
                    HTML runtime glue
                ]
                ]
            ]
        ]
    ]

    [stage:
        [node:
            [$in href: ./html-assembly-and-output/]
            [$in eyebrow: Output]
            [$in title: HTML assembly and output ownership]
            Assemble documents and runtime assets, validate output paths, write manifests and clean stale artefacts.
        ]
    ]
]
