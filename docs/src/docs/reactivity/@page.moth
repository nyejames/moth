page_head #= language_theme_head

#[navbar]

#[section, $md:
    @../ (Documentation) / Reactivity

    # Reactivity

    Reactivity lets a template subscribe to a stable source and update when that
    source changes. Moth uses this constrained model instead of general closures,
    callbacks or a second reactive type system.

    Source declarations and subscriptions remain explicit. Mutation follows the
    same access rules as every other value.
]

