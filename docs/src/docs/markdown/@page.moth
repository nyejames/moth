page_head #= language_theme_head

#[navbar]

#[section, $md:
    @../ (Documentation) / Plain Markdown

    # Plain Markdown

    A `.md` file remains ordinary Markdown. The compiler renders it at compile
    time and exports the HTML as `content`, but it never interprets Moth syntax
    inside the file.

    This keeps plain content portable across Markdown tools. Choose `.mtf` only
    when content needs Moth constants, templates or builder helpers.
]

