page_title #= "Generics"
page_description #= "Declaration-site generics, type application and local inference in Moth."
page_head #= language_theme_head

#[navbar]

#[section, $md:
    @../ (Documentation) / Generics

    # Generics

    Generics let one declaration describe a family of concrete structs, choices
    or functions. Moth specialises each use statically and doesn't expose erased
    generic values at runtime.

    Type inference stays local. It reads the immediate arguments and receiving
    type rather than searching later uses or the whole program.
]

