    doc_pager

page_title #= "Wiring"
page_description #= "Accepted Wire and Route parameter contracts, with current implementation status."
page_head #= language_theme_head

#[navbar]

#[section, $md:
    @../ (Documentation) / Wiring

    # Wiring

    Wiring describes parameter contracts for binding identity and choice
    constructors. It does not create callbacks, subscriptions or a UI runtime.

    **Accepted design; not yet implemented.** Wire and Route source contracts
    are unsupported by the current Alpha compiler until Phase 6 of the typed
    semantic expressions plan. The examples teach the accepted direction and
    do not claim to compile today. See @../progress (Progress) for current
    support and the complete @#wiring-introduction (Wiring reference) for exact
    rules.
]

