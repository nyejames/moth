page_head #= language_theme_head

#[navbar]

#[section, $md:
    @../ (Documentation) / Structs

    # Structs

    A struct creates a nominal type with named fields. Two structs remain
    different types even when their fields match, unlike structural record
    systems.

    Receiver methods use ordinary top-level function declarations in the same
    file as the type. Their first parameter shows shared or mutable access.
]

