@styles navbar,
    section,
    language_theme_head,
    doc_level,
    doc_pager

page_title #= "Language basics"
page_description #= "Blocks, comments, naming, core values, strings and characters in Moth."
page_head #= language_theme_head

#[navbar]

#[section, $md:
    @../ (Documentation) / Language basics

    # Language basics

    Moth uses a compact set of syntax rules across the whole language. Colons
    open blocks, semicolons close them and square brackets build strings rather
    than index collections.

    These choices differ from C-like and Python-like languages, but they keep
    each delimiter tied to one job. Start here before moving to bindings,
    control flow and user-defined types.
]

