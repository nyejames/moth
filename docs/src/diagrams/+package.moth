-- Reusable flow-diagram components for the Moth documentation site.
--
-- This package owns presentation only. Callers provide the semantic stages,
-- links and ordering. The components keep diagrams transparent and inherit the
-- surrounding page's text colour so they work with the existing docs theme.

flow_diagram_css #= [$css:
    .moth-flow {
        --flow-main-width: 17rem;
        --flow-stage-gap: 2.75rem;
        --flow-branch-gap: 1.3rem;
        --flow-node-radius: 0.7rem;

        margin-block: 2.5rem;
        color: inherit;
    }

    .moth-flow,
    .moth-flow * {
        box-sizing: border-box;
    }

    .moth-flow__pipeline {
        display: grid;
        gap: var(--flow-stage-gap);
    }

    .moth-flow__stage {
        position: relative;
        display: grid;
        grid-template-columns: var(--flow-main-width) minmax(0, 1fr);
        align-items: center;
        column-gap: 3rem;
        min-width: 0;
    }

    .moth-flow__stage + .moth-flow__stage::before {
        content: "";
        position: absolute;
        left: calc(var(--flow-main-width) / 2);
        top: calc(var(--flow-stage-gap) * -1);
        width: 0;
        height: calc(var(--flow-stage-gap) - 0.35rem);
        border-left: 1px solid currentColor;
        pointer-events: none;
    }

    .moth-flow__stage + .moth-flow__stage::after {
        content: "";
        position: absolute;
        left: calc((var(--flow-main-width) / 2) - 0.23rem);
        top: -0.55rem;
        width: 0.42rem;
        height: 0.42rem;
        border-right: 1px solid currentColor;
        border-bottom: 1px solid currentColor;
        transform: rotate(45deg);
        pointer-events: none;
    }

    .moth-flow__main {
        min-width: 0;
    }

    .moth-flow__details {
        position: relative;
        min-width: 0;
    }

    .moth-flow__details:not(:has(> *)) {
        display: none;
    }

    .moth-flow__details:has(> *)::before {
        content: "";
        position: absolute;
        right: 100%;
        top: 50%;
        width: 2.35rem;
        border-top: 1px solid currentColor;
        pointer-events: none;
    }

    .moth-flow__details:has(> *)::after {
        content: "";
        position: absolute;
        right: calc(100% - 0.05rem);
        top: calc(50% - 0.22rem);
        width: 0.42rem;
        height: 0.42rem;
        border-top: 1px solid currentColor;
        border-right: 1px solid currentColor;
        transform: rotate(45deg);
        pointer-events: none;
    }

    .moth-flow__node,
    .moth-flow__detail,
    .moth-flow__island-link {
        color: inherit;
        text-decoration: none;
        background: transparent;
        border: 1px solid currentColor;
        border-radius: var(--flow-node-radius);

        transition:
            transform 120ms ease,
            box-shadow 120ms ease;
    }

    .moth-flow__node:hover,
    .moth-flow__detail:hover,
    .moth-flow__island-link:hover {
        transform: translateY(-1px);
        box-shadow: 0 0 0 1px currentColor;
    }

    .moth-flow__node:focus-visible,
    .moth-flow__detail:focus-visible,
    .moth-flow__island-link:focus-visible {
        outline: 3px solid currentColor;
        outline-offset: 3px;
    }

    .moth-flow__node {
        display: grid;
        gap: 0.6rem;
        width: 100%;
        padding: 0.9rem 1rem;
    }

    .moth-flow__eyebrow {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.055em;
        text-transform: uppercase;
        opacity: 0.68;
    }

    .moth-flow__title {
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.25;
    }

    .moth-flow__description {
        font-size: 0.84rem;
        line-height: 1.42;
        opacity: 0.78;
    }

    .moth-flow__description:empty,
    .moth-flow__eyebrow:empty {
        display: none;
    }

    .moth-flow__branch {
        display: grid;
        gap: 1rem;
        min-width: 0;
    }

    .moth-flow__branch-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        opacity: 0.62;
    }

    .moth-flow__branch-label:empty {
        display: none;
    }

    .moth-flow__lane {
        display: flex;
        align-items: stretch;
        gap: var(--flow-branch-gap);
        padding: 3rem;
        min-width: 0;
    }

    .moth-flow__detail {
        position: relative;
        display: grid;
        align-content: center;
        min-width: 9.5rem;
        max-width: 14rem;
        padding: 0.65rem 0.8rem;
        font-size: 0.82rem;
        line-height: 1.32;
        text-align: center;
    }

    .moth-flow__lane > * + *::before {
        content: "";
        position: absolute;
        right: calc(100% + 0.01rem);
        top: 50%;
        width: var(--flow-branch-gap);
        border-top: 1px solid currentColor;
        pointer-events: none;
    }

    .moth-flow__lane > * + *::after {
        content: "";
        position: absolute;
        right: calc(100% + 0.05rem);
        top: calc(50% - 0.2rem);
        width: 0.38rem;
        height: 0.38rem;
        border-top: 1px solid currentColor;
        border-right: 1px solid currentColor;
        transform: rotate(45deg);
        pointer-events: none;
    }

    .moth-flow__island {
        position: relative;
        display: grid;
        min-width: 11rem;
        max-width: 16rem;
    }

    .moth-flow__island-link {
        display: grid;
        gap: 0.25rem;
        padding: 0.7rem 0.85rem;
        border-style: dashed;
    }

    .moth-flow__island-title {
        font-size: 0.84rem;
        font-weight: 700;
    }

    .moth-flow__island-description {
        font-size: 0.78rem;
        line-height: 1.35;
        opacity: 0.75;
    }

    .moth-flow__fanout {
        position: relative;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
        gap: 0.8rem;
        width: 100%;
    }

    .moth-flow__fanout > .moth-flow__detail {
        width: 100%;
        max-width: none;
    }

    .moth-flow__caption {
        margin-block-start: 1rem;
        font-size: 0.8rem;
        line-height: 1.4;
        opacity: 0.7;
    }

    .moth-flow__caption:empty {
        display: none;
    }

    @media (max-width: 64rem) {
        .moth-flow__stage {
            grid-template-columns: minmax(13rem, 15rem) minmax(0, 1fr);
            column-gap: 2.4rem;
        }

        .moth-flow__stage + .moth-flow__stage::before {
            left: 7.5rem;
        }

        .moth-flow__stage + .moth-flow__stage::after {
            left: calc(7.5rem - 0.23rem);
        }

        .moth-flow__lane {
            overflow-x: auto;
            padding-block: 0rem;
        }
    }

    @media (max-width: 46rem) {
        .moth-flow {
            --flow-stage-gap: 2.3rem;
        }

        .moth-flow__stage {
            grid-template-columns: minmax(0, 1fr);
            gap: 1.5rem;
        }

        .moth-flow__stage + .moth-flow__stage::before {
            left: 50%;
        }

        .moth-flow__stage + .moth-flow__stage::after {
            left: calc(50% - 0.23rem);
        }

        .moth-flow__details:has(> *)::before {
            right: auto;
            left: 50%;
            top: -1.5rem;
            width: 0;
            height: 1.15rem;
            border-top: 0;
            border-left: 1px solid currentColor;
        }

        .moth-flow__details:has(> *)::after {
            right: auto;
            left: calc(50% - 0.22rem);
            top: -0.6rem;
            transform: rotate(135deg);
        }

        .moth-flow__lane {
            display: grid;
            gap: 1.35rem;
            overflow: visible;
        }

        .moth-flow__detail,
        .moth-flow__island {
            width: 100%;
            min-width: 0;
            max-width: none;
        }

        .moth-flow__lane > * + *::before {
            right: auto;
            left: 50%;
            top: calc(var(--flow-branch-gap) * -1);
            width: 0;
            height: var(--flow-branch-gap);
            border-top: 0;
            border-left: 1px solid currentColor;
        }

        .moth-flow__lane > * + *::after {
            right: auto;
            left: calc(50% - 0.19rem);
            top: -0.48rem;
            transform: rotate(135deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .moth-flow__node,
        .moth-flow__detail,
        .moth-flow__island-link {
            transition: none;
        }
    }
]

flow_diagram_head #= [$html:
    <style>[flow_diagram_css]</style>
]

flow_diagram #= [$html:
    <figure class="moth-flow" aria-label="[$slot("label")]">
        <div class="moth-flow__pipeline">
            [$slot]
        </div>

        <figcaption class="moth-flow__caption">
            [$slot("caption")]
        </figcaption>
    </figure>
]

flow_stage #= [$html:
    <section class="moth-flow__stage">
        <div class="moth-flow__main">
            [$slot]
        </div>

        <div class="moth-flow__details">
            [$slot("details")]
        </div>
    </section>
]

flow_node #= [$html:
    <a class="moth-flow__node" href="[$slot("href")]">
        <span class="moth-flow__eyebrow">[$slot("eyebrow")]</span>
        <span class="moth-flow__title">[$slot("title")]</span>
        <span class="moth-flow__description">[$slot]</span>
    </a>
]

flow_branch #= [$html:
    <div class="moth-flow__branch">
        <div class="moth-flow__branch-label">[$slot("label")]</div>
        [$slot]
    </div>
]

flow_lane #= [$html:
    <div class="moth-flow__lane">
        [$slot]
    </div>
]

flow_detail #= [$html:
    <a class="moth-flow__detail" href="[$slot("href")]">
        [$slot]
    </a>
]

flow_island #= [$html:
    <aside class="moth-flow__island">
        <a class="moth-flow__island-link" href="[$slot("href")]">
            <span class="moth-flow__island-title">[$slot("title")]</span>
            <span class="moth-flow__island-description">[$slot]</span>
        </a>
    </aside>
]

flow_fanout #= [$html:
    <div class="moth-flow__fanout">
        [$slot]
    </div>
]

export:
    css #= flow_diagram_css
    diagram_head #= flow_diagram_head
    diagram #= flow_diagram
    stage #= flow_stage
    node #= flow_node
    branch #= flow_branch
    lane #= flow_lane
    detail #= flow_detail
    island #= flow_island
    fanout #= flow_fanout
;
