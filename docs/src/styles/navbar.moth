@html table, div, p, span

nav_style #= [$css("inline"):
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom-color: grey;
    border-bottom-style: solid;
    border-bottom-width: 1px;
    padding: 0rem 2rem 0rem 2rem;
]

navbar #= [$html:
    <nav style="[nav_style]" aria-label="Primary">
        <a
            href="[@/]"
            style="
                display: flex;
                align-items: center;
                gap: 0.6rem;
                padding: 0.9rem 0;
                text-decoration: none;
                font-weight: 700;
                letter-spacing: 0.04rem;
            "
        >
            <span
                aria-hidden="true"
                style="
                    font-family: var(--moth-font-family-emoji);
                    font-size: 1.4rem;
                    line-height: 1;
                    color: light-dark( #234970, #97b7ef );
                "
            >ʚĭɞ</span>

        </a>

        <div
            style="
                display: flex;
                align-items: center;
                gap: 1rem;
            "
        >
            <a
                href="[@/]docs/"
                style="
                    color: light-dark(var(--moth-text-lightmode), var(--moth-text-darkmode));
                    text-decoration: none;
                    font-weight: 500;
                    padding: 0.35rem 0;
                "
            >
                Docs
            </a>

            <a
                href="[@/]developer-docs/"
                style="
                    color: light-dark(var(--moth-text-lightmode), var(--moth-text-darkmode));
                    text-decoration: none;
                    font-weight: 500;
                    padding: 0.35rem 0;
                "
            >
                Developers
            </a>

            <a
                href="https://github.com/nyejames/moth"
                target="_blank"
                rel="noreferrer"
                aria-label="Moth GitHub repository"
                style="
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    color: light-dark(var(--moth-text-lightmode), var(--moth-text-darkmode));
                    padding: 0.35rem 0;
                "
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 16 16"
                    width="22"
                    height="22"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                    0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52
                    -.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07
                    -1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21
                    2.2.82a7.65 7.65 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82
                    1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2
                    0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
                </svg>
            </a>
        </div>
    </nav>
]