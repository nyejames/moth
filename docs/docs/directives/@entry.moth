@directives content as directives
@directives-basic content as directives_basic
@constraints content as constraints
@docs_styles navbar,
    section,
    language_theme_head,
    doc_level,
    doc_pager,
    sidebar,
    sync_navigation,
    sidebar_id

[$in title:["Directives"]]
[$in description:["Source directives for exports, build inputs, documentation and numeric constraints, with their attachment and operand rules."]]
[$in head:[language_theme_head]]

[navbar]
[sidebar]
listed = sync_navigation(sidebar_id)!
[section, $md:
    # Directives

    A source directive annotates the declaration or statement that follows it.
    Use one to publish a name, document a declaration or set a constraint on
    a function. For directives written inside brackets, see
    @../template-directives (Template directives). For HTML page metadata, see
    @../project-structure/#entry-config (Entry metadata and builder slots).
]

[section:
    [doc_level:
        [$in key:directive-pages]
        [$in title:Source directives]
        [$in advanced:[directives]]

        [directives_basic]
    ]
]

[section:
    [doc_level:
        [$in key:constraints]
        [$in title:Numeric constraints]
        [$in advanced:[constraints]]

        [$md:
            Ordinary arithmetic checks for failure. Use `$fast_math` to select
            fast semantics for eligible arithmetic on a function or complete
            statement. Use `$safe_math` to require that reachable work avoids
            fast arithmetic. Use `$infallible` to require that the boundary
            lets no error escape and can reach no Moth panic or trap.
        ]
    ]
]

[section:
    [doc_pager:
        [$in previous_path:../memory/]
        [$in previous_title:Memory and lifetimes]
        [$in next_path:../project-structure/]
        [$in next_title:Project structure]
    ]
]
