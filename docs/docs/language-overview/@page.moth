@styles navbar,
    section,
    language_theme_head,
    doc_level,
    doc_pager,
    sidebar,
    init_docs_sidebar

#[$in title:["Language basics"]]
#[$in description:["Blocks, comments, naming, core values, strings and MON syntax in Moth."]]
#[$in head:[language_theme_head]]

#[navbar]
#[sidebar]
init_docs_sidebar()!
#[section, $md:
    # Language basics

    Moth uses a compact set of syntax rules across the whole language. Colons
    open blocks, semicolons close them and square brackets build strings rather
    than index collections.

    These choices keep declarations, supplied values and blocks visually distinct.
    Start here before moving to bindings, control flow and user-defined types.
]

