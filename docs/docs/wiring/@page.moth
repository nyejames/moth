@styles navbar,
    section,
    language_theme_head,
    doc_level,
    doc_pager,
    sidebar,
    init_docs_sidebar

page_title #= "Wiring"
page_description #= "Accepted Wire and Route parameter contracts, with current implementation status."
page_head #= language_theme_head

#[navbar]
#[sidebar]
init_docs_sidebar()!
#[section, $md:
    # Wiring

    Wiring describes parameter contracts for binding identity and choice
    constructors. It does not create callbacks, subscriptions or a UI runtime.

    Wire and Route parameter contracts compile and run on the JS/HTML target.
    HTML-Wasm supports Wire arguments and rejects reachable route formation
    with a target diagnostic. Route invocation, composition, observation,
    channels and async remain outside this foundation. See @../progress (Progress) for current
    support and the complete @#wiring-introduction (Wiring reference) for exact
    rules.
]

#[section:
    [doc_level:
        [$in key:wiring-introduction]
        [$in title:Introduction and detailed reference]
