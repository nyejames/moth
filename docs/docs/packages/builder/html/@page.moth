@html-helpers content as html_advanced
@html-helpers-basic content as html_basic
@styles navbar,
    section,
    language_theme_head,
    doc_level,
    doc_pager,
    sidebar,
    init_docs_sidebar

page_title #= "@html"
page_description #= "Compile-time HTML helpers and canvas wrapper from the HTML builder."
page_head #= language_theme_head

#[navbar]
#[sidebar]
init_docs_sidebar()!
#[section, $md:
    # @html

    `@html` provides compile-time layout and formatting helpers through a
    source-backed builder package. Each helper remains an ordinary exported
    constant that folds into a `String`, rather than a hidden HTML syntax layer.
]

#[section:
    [doc_level:
        [$in key:html-helpers]
        [$in title:HTML helpers]
        [$in advanced:[html_advanced]]

        [html_basic]
    ]
]

#[section:
    [doc_pager:
        [$in previous_path:../]
        [$in previous_title:Builder packages]
        [$in next_path:../canvas/]
        [$in next_title:@web/canvas]
    ]
]
