@site content as site_advanced
@site-basic content as site_basic
@styles navbar,
    section,
    language_theme_head,
    doc_level,
    doc_pager,
    sidebar,
    init_docs_sidebar

[$in title:["@web/site"]]
[$in description:["Static site URL helpers from the HTML builder."]]
[$in head:[language_theme_head]]

[navbar]
[sidebar]
init_docs_sidebar()!
[section, $md:
    # @web/site

    `@web/site` provides compile-time helpers for static site URLs. It uses the
    structural site root rather than reading the browser or the current page.
]

[section:
    [doc_level:
        [$in key:site]
        [$in title:Static site URLs]
        [$in advanced:[site_advanced]]

        [site_basic]
    ]
]

[section:
    [doc_pager:
        [$in previous_path:../graphics/]
        [$in previous_title:@web/graphics]
        [$in next_path:../page/]
        [$in next_title:@web/page]
    ]
]