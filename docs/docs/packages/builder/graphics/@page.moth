@graphics content as graphics_advanced
@graphics-basic content as graphics_basic
@styles navbar,
    section,
    language_theme_head,
    doc_level,
    doc_pager,
    sidebar,
    init_docs_sidebar

page_title #= "@web/graphics"
page_description #= "WebGL2 rendering as a builder binding-backed runtime package."
page_head #= language_theme_head

#[navbar]
#[sidebar]
init_docs_sidebar()!
#[section, $md:
    # @web/graphics

    `@web/graphics` is the HTML builder's WebGL2 package. Its API will expose GPU
    resources, render state and draw calls through typed opaque handles while
    keeping WebGL's explicit graphics model.
]

#[section:
    [doc_level:
        [$in key:graphics]
        [$in title:Graphics]
        [$in advanced:[graphics_advanced]]

        [graphics_basic]
    ]
]

#[section:
    [doc_pager:
        [$in previous_path:../canvas/]
        [$in previous_title:@web/canvas]
        [$in next_path:../site/]
        [$in next_title:@web/site]
    ]
]
