[$in title:["@html"]]
[$in description:["Compile-time HTML markup helpers from the universal Core source package."]]
[$in head:[language_theme_head]]

[navbar]
[sidebar]
init_docs_sidebar()!
[section, $md:
    # @html

    `@html` provides compile-time layout and formatting helpers through a
    source-backed Core package. Each helper remains an ordinary exported
    constant that folds into a `String`, rather than a hidden HTML syntax layer.
    The common builder surface registers `@html` under every builder, including
    custom SDK builders, so it is never selected by builder configuration.
]

[section:
    [doc_level:
        [$in key:html-helpers]
        [$in title:HTML helpers]
        [$in advanced:[html_advanced]]

        [html_basic]
    ]
]

