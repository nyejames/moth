@text content as text_advanced
@text-basic content as text_basic
@styles navbar,
    section,
    language_theme_head,
    doc_level,
    doc_pager,
    sidebar,
    init_docs_sidebar

page_title #= "Core text"
page_description #= "Text helper functions for String values."
page_head #= language_theme_head

#[navbar]
#[sidebar]
init_docs_sidebar()!
#[section, $md:
    # Core text

    `@core/text` provides checks for `String` length, emptiness and substrings.
    Length counts Unicode scalar values rather than UTF-16 code units, which
    keeps the result aligned with Moth's `Char` model across backends.
]

#[section:
    [doc_level:
        [$in key:text-helpers]
        [$in title:Text helpers]
        [$in advanced:[text_advanced]]

        [text_basic]
    ]
]

#[section:
    [doc_pager:
        [$in previous_path:../math/]
        [$in previous_title:Core math]
        [$in next_path:../random/]
        [$in next_title:Core random]
    ]
]
