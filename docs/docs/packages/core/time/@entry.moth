[$in title:["Core time"]]
[$in description:["Duration, TimeMark and Timestamp helpers in @core/time."]]
[$in head:[language_theme_head]]

[navbar]
[sidebar]
init_docs_sidebar()!
[section, $md:
    # Core time

    `@core/time` separates monotonic elapsed time from UTC wall-clock time. Many
    APIs blur these domains, which makes duration measurements vulnerable to
    clock changes. Moth gives each domain an opaque type.
]

[section:
    [doc_level:
        [$in key:time-helpers]
        [$in title:Time helpers]
        [$in advanced:[time_advanced]]

        [time_basic]
    ]
]

