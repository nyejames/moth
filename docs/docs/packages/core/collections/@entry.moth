[$in title:["Core collections"]]
[$in description:["Ordered collection literals and common collection methods."]]
[$in head:[language_theme_head]]

[navbar]
[sidebar]
init_docs_sidebar()!
[section, $md:
    # Core collections

    Moth collections store ordered values through language-owned literals and
    methods backed by `@core/collections`. The package remains implicit because
    collection syntax belongs to the language rather than a user dependency clause.
]

[section:
    [doc_level:
        [$in key:collection-methods]
        [$in title:Collection methods]
        [$in advanced:[collections_advanced]]

        [collections_basic]
    ]
]

