@random content as random_advanced
@random-basic content as random_basic
@styles navbar,
    section,
    language_theme_head,
    doc_level,
    doc_pager,
    sidebar,
    init_docs_sidebar

[$in title:["Core random"]]
[$in description:["Random number helpers in the Core package."]]
[$in head:[language_theme_head]]

[navbar]
[sidebar]
init_docs_sidebar()!
[section, $md:
    # Core random

    `@core/random` provides bounded random `F64` and `I32` values. The package
    keeps randomness explicit through dependency clauses rather than adding a global
    language primitive.
]

[section:
    [doc_level:
        [$in key:random-helpers]
        [$in title:Random helpers]
        [$in advanced:[random_advanced]]

        [random_basic]
    ]
]

[section:
    [doc_pager:
        [$in previous_path:../text/]
        [$in previous_title:Core text]
        [$in next_path:../time/]
        [$in next_title:Core time]
    ]
]
