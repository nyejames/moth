[$in title:["Core math"]]
[$in description:["F64 math constants and helper functions."]]
[$in head:[language_theme_head]]

[navbar]
[sidebar]
init_docs_sidebar()!
[section, $md:
    # Core math

    `@core/math` provides finite `F64` constants and functions for
    trigonometry, powers, rounding and clamping. Unlike host math libraries,
    every result must satisfy Moth's finite-number contract before source code
    observes it.
]

[section:
    [doc_level:
        [$in key:math-helpers]
        [$in title:Math helpers]
        [$in advanced:[math_advanced]]

        [math_basic]
    ]
]

[section:
    [doc_pager:
