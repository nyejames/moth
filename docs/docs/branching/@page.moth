@pattern-matching content as pattern_matching
@pattern-matching-basic content as pattern_matching_basic
@patterns-and-exhaustiveness content as patterns_and_exhaustiveness
@patterns-and-exhaustiveness-basic content as patterns_and_exhaustiveness_basic
@styles navbar,
    section,
    language_theme_head,
    doc_level,
    doc_pager,
    sidebar,
    init_docs_sidebar

page_title #= "Branching"
page_description #= "If statements, value-producing control flow, pattern matching and exhaustiveness in Moth."
page_head #= language_theme_head

#[navbar]
#[sidebar]
init_docs_sidebar()!
#[section, $md:
    # Branching

    Use statement `if` for a Boolean decision. Use a full match when one value
    can take distinct literal, range, option or choice forms.

    Unlike C-style `switch`, Moth never falls through between arms. `else =>`
    alone marks the catch-all, and exhaustive matches can omit it when the
    compiler can prove every case appears.
]

#[section:
    [doc_level:
        [$in key:statement-if]
        [$in title:Statement if]
        [$in advanced:[statement_if]]

        [statement_if_basic]
    ]
]

